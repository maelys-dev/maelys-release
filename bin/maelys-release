INVARIANTS = [
    "usage and agent discovery share one catalog",
    "transactional commands plan by default and require --apply",
    "stdout carries success data; stderr carries failures",
    "--json and --format json are identical",
    "unknown or duplicated options are refused",
]


def descriptor(command: dict, summary: bool = False) -> dict:
    entry = {
        "id": command["id"], "pattern": command["pattern"], "usage": command["usage"],
        "purpose": command["purpose"], "effect": command["effect"],
        "outputMode": command.get("outputMode", "json-envelope"), "external": False,
        "hidden": command["hidden"], "available": True,
        "input": {"synopsis": command["usage"], "operands": command["operands"],
                  "options": [{key: value for key, value in item.items() if key != "hidden"}
                              for item in command["options"] if not item.get("hidden")],
                  "constraints": command.get("constraints", []), "passthrough": False},
    }
    if not summary:
        entry["outputSchema"] = command["outputSchema"]
        entry["exitCodes"] = EXIT_CODES
    return entry


def command_by_id(identifier: str) -> dict:
    for command in CATALOG:
        if command["id"] == identifier:
            return command
    raise Failure("INVALID_COMMAND", f"Unknown command identifier '{identifier}'.",
                  "Run describe --summary to list the command identifiers.")


def command_help(command: dict) -> str:
    lines = [f"{PROGRAM} {command['usage']}", "", command["purpose"], ""]
    if command["operands"]:
        lines.append("OPERANDS")
        lines.extend(f"  {item['name']:<18} {item['summary']}" for item in command["operands"])
        lines.append("")
    visible = [item for item in command["options"] if not item.get("hidden")]
    if visible:
        lines.append("OPTIONS")
        for item in visible:
            spelled = item["long"] + (f" {item['argument']['name']}" if "argument" in item else "")
            default = f" (default {item['default']})" if "default" in item else ""
            lines.append(f"  {spelled:<28} {item['summary']}{default}")
        lines.append("")
    return "\n".join(lines).rstrip("\n") + "\n"


def guide() -> str:
    lines = [f"{PROGRAM} {socle_version()} - release socle of the Maelys repositories", "",
             "USAGE", f"  {PROGRAM} COMMAND [OPERANDS] [OPTIONS]", "", "COMMANDS"]
    width = max(len(command["usage"]) for command in CATALOG if not command["hidden"])
    lines.extend(f"  {command['usage']:<{width}}  {command['purpose']}" for command in CATALOG if not command["hidden"])
    lines.extend(["", "GLOBAL OPTIONS"])
    for item in GLOBAL_OPTIONS:
        spelled = item["long"] + (f" {'|'.join(item['argument']['choices'])}" if "argument" in item else "")
        lines.append(f"  {spelled:<28} {item['summary']}")
    lines.extend(["", f"Run '{PROGRAM} describe --format json' for the machine-readable catalog."])
    return "\n".join(lines) + "\n"


# ---- parsing --------------------------------------------------------------------

def resolve(words: list[str]) -> tuple[dict | None, int]:
    """The command whose pattern starts the words, and the words consumed."""
    best: dict | None = None
    for command in CATALOG:
        pattern = command["pattern"]
        if words[:len(pattern)] == pattern and (best is None or len(pattern) > len(best["pattern"])):
            best = command
    return best, len(best["pattern"]) if best else 0


def parse(argv: list[str]) -> tuple[Invocation, dict]:
    """Validate the command line in the contract's causal order."""
    words: list[str] = []
    raw_options: list[tuple[str, str | None]] = []
    index = 0
    passthrough: list[str] = []
    while index < len(argv):
        word = argv[index]
        if word == "--":
            passthrough = argv[index + 1:]
            break
        if word.startswith("--") and len(word) > 2:
            name, separator, value = word.partition("=")
            raw_options.append((name, value if separator else None))
            index += 1
            # an option that takes an argument consumes the next word
            definition = next((item for item in GLOBAL_OPTIONS if item["long"] == name), None)
            if definition is None:
                command, _ = resolve(words)
                if command is not None:
                    definition = next((item for item in command["options"] if item["long"] == name), None)
            if definition and "argument" in definition and not separator:
                if index >= len(argv):
                    raise Failure("VALIDATION_FAILED", f"Option {name} needs a value {definition['argument']['name']}.",
                                  "Run describe for this command and pass the option's argument.")
                raw_options[-1] = (name, argv[index])
                index += 1
            continue
        if word.startswith("-") and word != "-":
            raise Failure("VALIDATION_FAILED", f"Option {word} is not supported: options are spelled --name.",
                          "Run describe for this command and use only its declared options.")
        words.append(word)
        index += 1
    if not words and any(name in ("--help", "--version") for name, _ in raw_options):
        words = ["help"] if any(name == "--help" for name, _ in raw_options) else ["version"]
        raw_options = [(name, value) for name, value in raw_options if name not in ("--help", "--version")]
    if not words:
        raise Failure("INVALID_COMMAND", "No command given.", f"Run '{PROGRAM} help' or 'describe --summary'.")
    command, consumed = resolve(words)
    if command is None:
        raise Failure("INVALID_COMMAND", f"Unknown command '{' '.join(words)}'.",
                      "Run describe --summary and use one of the listed command identifiers.")
    operands = words[consumed:] + passthrough
    # rendering options
    fmt = os.environ.get("MAELYS_CLI_FORMAT", "text")
    compact = False
    non_interactive = False
    rendering = False
    help_requested = False
    options: dict[str, object] = {}
    seen: set[str] = set()
    known = {item["long"]: item for item in command["options"]}
    for name, value in raw_options:
        if name in seen and not (name in known and known[name]["repeatable"]):
            raise Failure("VALIDATION_FAILED", f"Option {name} is given twice.", "Give each option once.")
        seen.add(name)
        if name == "--format":
            if value not in ("text", "json", "jsonl"):
                raise Failure("VALIDATION_FAILED", f"--format takes text, json or jsonl, not '{value}'.", "Use one of the choices.")
            fmt, rendering = value, True
        elif name == "--json":
            fmt, rendering = "json", True
        elif name == "--compact":
            compact, rendering = value != "false", True
        elif name == "--pretty":
            compact, rendering = value == "false", True
        elif name == "--non-interactive":
            non_interactive = value != "false"
        elif name == "--color":
            if value not in ("auto", "always", "never"):
                raise Failure("VALIDATION_FAILED", f"--color takes auto, always or never, not '{value}'.", "Use one of the choices.")
        elif name == "--help":
            help_requested = True
        elif name in ("--dry-run", "--plan") and isinstance(command["effect"], dict):
            raise Failure("VALIDATION_FAILED", f"Option {name} is not supported by '{command['id']}': it plans by default.",
                          "Run without --apply to plan, then add --apply to write.")
        elif name not in known:
            raise Failure("VALIDATION_FAILED", f"Option {name} is not supported by '{command['id']}'. Use '{command['usage']}'.",
                          "Run describe for this command and use only its declared options.")
        else:
            definition = known[name]
            if "argument" in definition:
                argument = definition["argument"]
                if value is None:
                    raise Failure("VALIDATION_FAILED", f"Option {name} needs a value {argument['name']}.",
                                  "Pass the option's argument.")
                if argument["type"] == "choice" and value not in argument["choices"]:
                    raise Failure("VALIDATION_FAILED", f"Option {name} takes {', '.join(argument['choices'])}, not '{value}'.",
                                  "Use one of the choices.")
                if argument["type"] == "hex" and not re.fullmatch(r"[0-9a-f]+", value):
                    raise Failure("VALIDATION_FAILED", f"Option {name} takes lowercase hexadecimal, not '{value}'.",
                                  "Pass a commit sha.")
                options[name] = value
            else:
                options[name] = value != "false"
    for definition in command["options"]:
        if definition["required"] and definition["long"] not in options:
            raise Failure("VALIDATION_FAILED", f"Option {definition['long']} is required by '{command['id']}'.",
                          f"Use '{command['usage']}'.")
    if help_requested:
        command, operands, options = command_by_id("help"), [command["id"]], {}
    required = sum(1 for item in command["operands"] if item["required"])
    variadic = any(item["variadic"] for item in command["operands"])
    if len(operands) < required or (not variadic and len(operands) > len(command["operands"])):
        raise Failure("VALIDATION_FAILED", f"Operands do not match '{command['id']}'. Use '{command['usage']}'.",
                      "Use the synopsis returned by describe and retry.")
    for item, value in zip(command["operands"], operands):
        if item.get("choices") and value not in item["choices"]:
            raise Failure("VALIDATION_FAILED", f"{item['name']} takes {', '.join(item['choices'])}, not '{value}'.",
                          f"Use '{command['usage']}'.")
    if fmt == "jsonl" and command.get("outputMode") != "json-records":
        raise Failure("VALIDATION_FAILED", f"--format jsonl is accepted only by json-records commands, not '{command['id']}'.",
                      "Use --format json.")
    del rendering
    return Invocation(command, operands, options, fmt, compact, non_interactive), command


# ---- rendering ---------------------------------------------------------------------

def envelope(command_id: str, ok: bool, exit_code: int, payload: dict, compact: bool) -> str:
    body: dict = {"schemaVersion": SCHEMA_VERSION, "contract": CONTRACT, "command": command_id, "ok": ok,
                  "exitCode": exit_code}
    body["data" if ok else "error"] = payload
    return json.dumps(body, separators=(",", ":") if compact else None, indent=None if compact else 2,
                      ensure_ascii=False) + "\n"


def colored(text: str, argv: list[str]) -> str:
    wants = "always" in [value for name, value in _color_options(argv)] and True
    never = any(value == "never" for _, value in _color_options(argv)) or os.environ.get("NO_COLOR") \
        or os.environ.get("TERM") == "dumb"
    if never or not (wants or sys.stderr.isatty()):
        return text
    return f"\033[31m{text}\033[0m"


def _color_options(argv: list[str]) -> list[tuple[str, str]]:
    found = []
    for index, word in enumerate(argv):
        if word.startswith("--color="):
            found.append(("--color", word.split("=", 1)[1]))
        elif word == "--color" and index + 1 < len(argv):
            found.append(("--color", argv[index + 1]))
    return found


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    command_id = ""
    # The rendering of a parse failure follows the rendering options as
    # given, before the parser validates them.
    fmt = os.environ.get("MAELYS_CLI_FORMAT", "text")
    for index, word in enumerate(argv):
        if word == "--json" or word == "--format=json":
            fmt = "json"
        elif word == "--format" and index + 1 < len(argv) and argv[index + 1] in ("json", "jsonl"):
            fmt = "json"
        elif word == "--format=jsonl":
            fmt = "json"
    compact = "--compact" in argv or "--pretty=false" in argv
    try:
        invocation, command = parse(argv)
        command_id, fmt, compact = command["id"], invocation.format, invocation.compact
        data, exit_code = command["handler"](invocation)
        if fmt == "text":
            if command_id in ("adopt", "check", "preflight", "declarations"):
                render_checks(data["checks"], sys.stdout)
            sys.stdout.write(TEXT[command_id](data))
        elif fmt == "jsonl":
            for record in data["records"]:
                sys.stdout.write(json.dumps(record, separators=(",", ":")) + "\n")
        else:
            sys.stdout.write(envelope(command_id, True, exit_code, data, compact))
        sys.stdout.flush()
        return exit_code
    except Failure as failure:
        error = {"code": failure.code, "message": failure.message}
        if failure.hint:
            error["hint"] = failure.hint
        if fmt == "text":
            sys.stderr.write(colored(f"{PROGRAM}: [{failure.code}] {failure.message}", argv) + "\n")
            if failure.hint:
                sys.stderr.write(f"Hint: {failure.hint}\n")
        else:
            sys.stderr.write(envelope(command_id or "unknown", False, EXIT_FAILURE, error, compact))
        return EXIT_FAILURE
    except OSError as error:
        message = {"code": "IO_FAILED", "message": f"{error.strerror}: {error.filename}" if error.filename else str(error),
                   "hint": "Check the path and its permissions."}
        if fmt == "text":
            sys.stderr.write(f"{PROGRAM}: [IO_FAILED] {message['message']}\nHint: {message['hint']}\n")
        else:
            sys.stderr.write(envelope(command_id or "unknown", False, EXIT_FAILURE, message, compact))
        return EXIT_FAILURE


if __name__ == "__main__":
    sys.exit(main())
