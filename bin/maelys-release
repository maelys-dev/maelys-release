# ---- the socle itself --------------------------------------------------------

def socle_root() -> pathlib.Path:
    return pathlib.Path(__file__).resolve().parent.parent




def socle_version() -> str:
    for candidate in (socle_root() / "VERSION", identity.share_dir(socle_root()) / "VERSION"):
        if candidate.is_file():
            version = candidate.read_text(encoding="utf-8").strip()
            if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", version):
                raise Failure("PRECONDITION_FAILED", f"The socle's VERSION is not X.Y.Z: {version!r}.",
                              "Fix VERSION of the socle; nothing generated from it can be trusted.")
            return version
    raise Failure("NOT_FOUND", "VERSION of the socle not found.", "Run from a maelys-release checkout.")


class SocleProgram(cli.Program):
    """Validate the private environment inside the contract, before any handler."""

    def parse(self, argv: list) -> tuple[Invocation, dict]:
        invocation, command = super().parse(argv)

        def checked(invocation: Invocation):
            host.HOST._self_test()
            return command["handler"](invocation)

        return invocation, {**command, "handler": checked}






