#!/usr/bin/env python3
# SPDX-License-Identifier: MPL-2.0
"""maelys-release: adopt, check, rehearse and publish through the Maelys
release socle.

A command-line program of the agent-cli/v2 contract, built on maelys_cli,
the Python framework of maelys-cli: bin/maelys_cli.py is that framework's
python/maelys_cli.py at the commit dependencies/maelys-cli.pin names, byte for
byte, and `maelys-release vendor` refreshes it. One catalog drives the
parser, help, describe and completion; success is a JSON envelope on
stdout, failure an envelope on stderr; exit 0 completed, 1 failed, 2 a
validation that found violations. Transactional commands (adopt, tap) plan
by default and write with --apply.

Standard library only; python3 >= 3.9. The socle is the checkout (or the
installed prefix) this file runs from: share/ holds the texts installed
into products, VERSION its version.
"""
from __future__ import annotations

import difflib
import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import maelys_cli as cli  # noqa: E402

PROGRAM = "maelys-release"
PRODUCT = "Maelys Release"
Failure = cli.Failure
Invocation = cli.Invocation
EXIT_OK = cli.EXIT_OK
EXIT_FAILURE = cli.EXIT_FAILURE
EXIT_VIOLATIONS = cli.EXIT_VIOLATIONS

SOCLE_REPOSITORY = "maelys-dev/maelys-release"
DEFAULT_TAP = "maelys-dev/homebrew-tap"
DEFAULT_IMAGE = "ubuntu:24.04"
SOCLE_LINUX_PACKAGES = "build-essential dpkg-dev file rpm"  # the release.yml default
BOTTLES = '\'["macos-15","macos-26"]\''
PLATFORMS = {"linux-x86_64": "linux/amd64", "linux-arm64": "linux/arm64"}
MANAGED = (
    ".github/workflows/release.yml",
    "scripts/checkout-dependency.sh",
    "AGENTS.md",
    "CLAUDE.md",
    ".claude/skills/maelys-release/SKILL.md",
    "RELEASING.md",
    ".github/workflows/ci.yml",
)
CI_USES = re.compile(rf"({re.escape(SOCLE_REPOSITORY)}/\.github/workflows/check-product\.yml@)[0-9a-f]{{40}} # \S+")
BEGIN = "<!-- maelys-release:begin -->"
END = "<!-- maelys-release:end -->"


# ---- the socle itself --------------------------------------------------------

def socle_root() -> pathlib.Path:
    return pathlib.Path(__file__).resolve().parent.parent


def share_dir() -> pathlib.Path:
    root = socle_root()
    for candidate in (root / "share", root / "share" / "maelys-release"):
        if (candidate / "agents").is_dir():
            return candidate
    raise Failure("NOT_FOUND", f"share/agents not found under {root}.",
                  "Run from a maelys-release checkout or an installed prefix.")


def socle_version() -> str:
    for candidate in (socle_root() / "VERSION", share_dir() / "VERSION"):
        if candidate.is_file():
            return candidate.read_text(encoding="utf-8").strip()
    raise Failure("NOT_FOUND", "VERSION of the socle not found.", "Run from a maelys-release checkout.")


def run(command: list[str], cwd: pathlib.Path | None = None, env: dict[str, str] | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(command, cwd=cwd, env=env, check=False, text=True,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def git(*arguments: str, cwd: pathlib.Path | None = None, check: bool = True) -> str:
    completed = run(["git", *arguments], cwd=cwd)
    if check and completed.returncode != 0:
        raise Failure("PROCESS_FAILED", f"git {' '.join(arguments)} failed: {completed.stderr.strip()}",
                      "Fix the repository state and retry.")
    return completed.stdout.strip() if completed.returncode == 0 else ""


def socle_identity(sha: str, tag: str) -> tuple[str, str]:
    """The commit and tag written into the managed files.

    The files a product receives must be exactly what the pinned socle
    regenerates, so a checkout with uncommitted changes to what adopt
    writes (share/, bin/) is refused: its output would name a commit that
    does not produce it.
    """
    if sha:
        return sha, tag or "untagged"
    root = socle_root()
    if not (root / ".git").exists():
        raise Failure("PRECONDITION_FAILED", "This socle is not a git checkout, so its commit is unknown.",
                      "Pass --socle-sha SHA --socle-tag TAG, or run from a checkout.")
    dirty = git("status", "--porcelain", "--", "share", "bin", "VERSION", cwd=root, check=False)
    if dirty:
        raise Failure("PRECONDITION_FAILED", "This socle checkout has uncommitted changes in share/, bin/ or VERSION;"
                      " what it would write names a commit that does not produce it.",
                      "Commit or stash the socle's changes, or run the socle at a tag.")
    return git("rev-parse", "HEAD", cwd=root), git("describe", "--tags", "--exact-match", cwd=root, check=False) or "untagged"


# ---- the product contract ----------------------------------------------------

class Declarations:
    """What a product declares, read once and used by every command."""

    def __init__(self, project: pathlib.Path, product: str) -> None:
        self.project = project
        self.product = product
        self.version = ""
        self.formulas: list[str] = []
        self.render_command = ""
        self.dependencies: list[str] = []
        self.linux_packages = ""
        self.macos_packages = ""
        self.checks: list[dict] = []

    @property
    def valid(self) -> bool:
        """Whether adopt may proceed; a warning is reported by check only."""
        return all(check["status"] in ("ok", "note", "warn") for check in self.checks)

    def add(self, status: str, message: str) -> None:
        self.checks.append({"status": status, "message": message})


def parse_packages(text: str) -> tuple[str, str]:
    """dependencies/packages: one package per line under [linux] or [macos]."""
    packages: dict[str, list[str]] = {"linux": [], "macos": []}
    section = ""
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("["):
            if line in ("[linux]", "[macos]"):
                section = line[1:-1]
                continue
            raise ValueError(f"unknown section {line} at line {number}")
        if not section:
            raise ValueError(f"package outside a [linux] or [macos] section at line {number}")
        if len(line.split()) != 1 or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9+._@:-]*", line):
            raise ValueError(f"one package per line at line {number}: {raw}")
        packages[section].append(line)
    return " ".join(packages["linux"]), " ".join(packages["macos"])


def read_declarations(project: pathlib.Path, product: str) -> Declarations:
    decl = Declarations(project, product)
    version_file = project / "VERSION"
    if not version_file.is_file():
        decl.add("missing", "VERSION file")
    else:
        text = version_file.read_text(encoding="utf-8").strip()
        if re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", text):
            decl.version = text
            decl.add("ok", "VERSION file")
        else:
            decl.add("missing", "VERSION must be X.Y.Z")
    packager = project / "scripts" / "package-release.sh"
    decl.add("ok" if packager.is_file() and os.access(packager, os.X_OK) else "missing",
             "scripts/package-release.sh TARGET writing dist/")
    changelog = project / "CHANGELOG.md"
    if not changelog.is_file():
        decl.add("missing", "CHANGELOG.md")
    else:
        decl.add("ok", "CHANGELOG.md")
        # The release of VERSION needs its dated entry; the workflow only
        # compares VERSION with the tag, so the entry is checked here.
        if decl.version:
            pattern = rf"^## {re.escape(decl.version)}\s.*[0-9]{{4}}-[0-9]{{2}}-[0-9]{{2}}"
            if re.search(pattern, changelog.read_text(encoding="utf-8"), re.MULTILINE):
                decl.add("ok", f"CHANGELOG.md has a dated ## {decl.version} entry")
            else:
                decl.add("missing", f"CHANGELOG.md needs a dated entry: ## {decl.version} — YYYY-MM-DD")
    # Every packaging/homebrew/NAME.rb.in becomes one tap job publishing NAME:
    # a formula is named after what it installs, not after the repository.
    homebrew = project / "packaging" / "homebrew"
    decl.formulas = sorted(path.name[: -len(".rb.in")] for path in homebrew.glob("*.rb.in")) if homebrew.is_dir() else []
    if decl.formulas:
        decl.add("ok", "Homebrew formula templates: " + " ".join(decl.formulas))
    else:
        decl.add("note", "no packaging/homebrew/*.rb.in: no tap job")
    renderer = project / "scripts" / "render-homebrew-formula.sh"
    if renderer.is_file() and os.access(renderer, os.X_OK):
        decl.render_command = "sh scripts/render-homebrew-formula.sh TAG OUTPUT"
        decl.add("ok", "scripts/render-homebrew-formula.sh renders the formula")
    # Dependencies: one dependencies/NAME.pin per Maelys repository, nearest
    # tag on line 1 for humans and the pinned commit on line 2. The managed
    # scripts/checkout-dependency.sh clones each of them from the pin.
    dependencies = project / "dependencies"
    for pin in sorted(dependencies.glob("*.pin")) if dependencies.is_dir() else []:
        name = pin.name[: -len(".pin")]
        lines = pin.read_text(encoding="utf-8").splitlines()
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", name):
            decl.add("missing", f"dependencies/{pin.name}: the file is named after the repository, [a-z0-9-]")
        elif len(lines) >= 2 and re.fullmatch(r"[0-9a-f]{40}", lines[1].strip()):
            decl.dependencies.append(name)
        else:
            decl.add("missing", f"dependencies/{pin.name}: line 2 must be the pinned commit (line 1 its tag)")
    if (project / "adapter").is_dir():
        decl.add("refused", "adapter/ is the pre-0.14 layout: git mv adapter/<NAME>_PIN dependencies/<name>.pin"
                 " and adapter/PACKAGES dependencies/packages, then delete adapter/ and the Makefile lines that read it")
    if decl.dependencies:
        decl.add("ok", "pinned dependencies: " + " ".join(decl.dependencies))
    scripts = project / "scripts"
    stray = sorted(path.name for path in scripts.glob("checkout-*.sh")
                   if path.name != "checkout-dependency.sh") if scripts.is_dir() else []
    if stray:
        decl.add("refused", "scripts/" + " scripts/".join(stray)
                 + ": dependencies are cloned from dependencies/*.pin by the managed"
                 " scripts/checkout-dependency.sh NAME; delete these")
    ci = project / ".github" / "workflows" / "ci.yml"
    if ci.is_file():
        if CI_USES.search(ci.read_text(encoding="utf-8")):
            decl.add("ok", ".github/workflows/ci.yml calls check-product.yml of the socle")
        else:
            decl.add("warn", ".github/workflows/ci.yml does not call the socle's check-product.yml: add a job"
                     f" 'uses: {SOCLE_REPOSITORY}/.github/workflows/check-product.yml@SHA # TAG'"
                     f" with 'product: {product}', as adopt would create it")
    packages = dependencies / "packages"
    if packages.is_file():
        try:
            decl.linux_packages, decl.macos_packages = parse_packages(packages.read_text(encoding="utf-8"))
            decl.add("ok", f"dependencies/packages: linux [{decl.linux_packages}] macos [{decl.macos_packages}]")
        except ValueError as error:
            decl.add("missing", f"dependencies/packages: {error}")
    return decl


def pinned_product(project: pathlib.Path) -> str:
    """The product name the existing release.yml carries, or ''."""
    workflow = project / ".github" / "workflows" / "release.yml"
    if not workflow.is_file():
        return ""
    match = re.search(r"^\s+product:\s+(\S+)\s*$", workflow.read_text(encoding="utf-8"), re.MULTILINE)
    return match.group(1) if match else ""


def project_of(invocation: Invocation) -> tuple[pathlib.Path, str]:
    directory = pathlib.Path(invocation.operands[0])
    if not directory.is_dir():
        raise Failure("NOT_FOUND", f"DIR is not a directory: {directory}.", "Pass the product repository.")
    project = directory.resolve()
    # The product name comes from --product, else from the release.yml the
    # product already carries, else from the directory: a worktree or a
    # scratch clone is rarely named after the product it holds.
    product = invocation.option("--product") or pinned_product(project) or project.name
    if not re.fullmatch(r"[a-z0-9-]+", product):
        raise Failure("VALIDATION_FAILED", f"Product name must be [a-z0-9-]: {product}.",
                      "Pass --product NAME with a valid name.")
    return project, product


def require_valid(decl: Declarations, action: str) -> None:
    if not decl.valid:
        problems = [check["message"] for check in decl.checks if check["status"] not in ("ok", "note")]
        raise Failure("PRECONDITION_FAILED", f"{decl.project} does not meet the product contract, so {action} is refused: "
                      + "; ".join(problems) + ".", f"Run '{PROGRAM} check {decl.project}' and fix every violation.")


# ---- the managed files -------------------------------------------------------

def render_text(template: pathlib.Path, mapping: dict[str, str]) -> str:
    text = template.read_text(encoding="utf-8")
    for key, value in mapping.items():
        text = text.replace(f"@{key}@", value)
    return text


def release_workflow(decl: Declarations, sha: str, tag: str, version: str) -> str:
    lines = [
        "name: release",
        "",
        f"# Managed by maelys-release {tag} ({version}). Regenerate with",
        f"# '{PROGRAM} adopt' of maelys-release; do not edit by hand.",
        # A job that calls a reusable workflow cannot be granted more than the
        # caller workflow declares at the top level, so the ceiling is set
        # here and each job narrows it.
        "on:",
        "  push:",
        '    tags: ["v*"]',
        "  workflow_dispatch:",
        "    inputs:",
        "      tag:",
        "        description: Existing signed tag whose Homebrew publication is replayed",
        "        required: true",
        "        type: string",
        "",
        "permissions:",
        "  contents: write",
        "  id-token: write",
        "  attestations: write",
        "",
        "jobs:",
        "  release:",
        "    if: github.event_name == 'push'",
        f"    uses: {SOCLE_REPOSITORY}/.github/workflows/release.yml@{sha} # {tag}",
        "    permissions:",
        "      contents: write",
        "      id-token: write",
        "      attestations: write",
        "    with:",
        f"      product: {decl.product}",
    ]
    if decl.dependencies:
        lines.append("      dependency_checkout: |")
        lines.extend(f"        sh scripts/checkout-dependency.sh {name}" for name in decl.dependencies)
    if decl.linux_packages:
        lines.append(f"      linux_packages: {SOCLE_LINUX_PACKAGES} {decl.linux_packages}")
    if decl.macos_packages:
        lines.append(f"      macos_packages: {decl.macos_packages}")
    for formula in decl.formulas:
        lines.extend([
            "",
            f"  tap-{formula}:",
            "    needs: release",
            "    if: always() && (needs.release.result == 'success' || needs.release.result == 'skipped')",
            f"    uses: {SOCLE_REPOSITORY}/.github/workflows/tap.yml@{sha} # {tag}",
            "    permissions:",
            "      contents: write",
            "      id-token: write",
            "      attestations: write",
            "    with:",
            f"      product: {formula}",
            "      tag: ${{ inputs.tag }}",
        ])
        if decl.render_command:
            lines.append(f"      render_command: {decl.render_command} {formula}")
        lines.extend([
            f"      bottles: {BOTTLES}",
            "    secrets:",
            "      tap_token: ${{ secrets.HOMEBREW_TAP_TOKEN }}",
            "      tap_signing_key: ${{ secrets.HOMEBREW_TAP_SIGNING_KEY }}",
        ])
    return "\n".join(lines) + "\n"


def ci_workflow(decl: Declarations, sha: str, tag: str, version: str) -> str:
    """Created once from the same declarations, then owned by the product."""
    lines = [
        "name: ci",
        "",
        f"# Created by maelys-release {tag} ({version}) and owned by this repository: add",
        "# jobs next to check; adopt keeps the socle line of check current.",
        "on:",
        "  push:",
        "    branches: [main]",
        "  pull_request:",
        "",
        "permissions:",
        "  contents: read",
        "",
        "jobs:",
        "  check:",
        f"    uses: {SOCLE_REPOSITORY}/.github/workflows/check-product.yml@{sha} # {tag}",
        "    with:",
        f"      product: {decl.product}",
    ]
    return "\n".join(lines) + "\n"


def managed_block(existing: str | None, block: str) -> str:
    """Replace the block between the markers, or append it."""
    if existing is not None and BEGIN in existing:
        out: list[str] = []
        skipping = False
        for line in existing.splitlines():
            if line.strip() == BEGIN:
                out.extend([BEGIN, *block.rstrip("\n").splitlines(), END])
                skipping = True
            elif line.strip() == END:
                skipping = False
            elif not skipping:
                out.append(line)
        return "\n".join(out) + "\n"
    head = (existing.rstrip("\n") + "\n\n") if existing else ""
    return head + BEGIN + "\n" + block.rstrip("\n") + "\n" + END + "\n"


def stage(decl: Declarations, sha: str, tag: str) -> dict[str, tuple[str, bool]]:
    """Every managed file as (content, executable), rendered for the product."""
    version = socle_version()
    share = share_dir()
    formulas = ", ".join(f"packaging/homebrew/{name}.rb.in" for name in decl.formulas) \
        or "packaging/homebrew/<name>.rb.in"
    mapping = {"PRODUCT": decl.product, "FORMULAS": formulas, "SOCLE_TAG": tag, "SOCLE_VERSION": version}
    staged: dict[str, tuple[str, bool]] = {
        ".github/workflows/release.yml": (release_workflow(decl, sha, tag, version), False),
        ".claude/skills/maelys-release/SKILL.md": (render_text(share / "agents" / "claude-skill.md", mapping), False),
    }
    if decl.dependencies:
        staged["scripts/checkout-dependency.sh"] = (
            render_text(share / "templates" / "checkout-dependency.sh", mapping), True)
    block = render_text(share / "agents" / "instructions-block.md", mapping)
    for name in ("AGENTS.md", "CLAUDE.md"):
        path = decl.project / name
        existing = path.read_text(encoding="utf-8") if path.is_file() else None
        staged[name] = (managed_block(existing, block), False)
    if not (decl.project / "RELEASING.md").is_file():
        staged["RELEASING.md"] = (render_text(share / "templates" / "RELEASING.md", mapping), False)
    ci = decl.project / ".github" / "workflows" / "ci.yml"
    if not ci.is_file():
        staged[".github/workflows/ci.yml"] = (ci_workflow(decl, sha, tag, version), False)
    else:
        # The product owns its ci.yml; only the line naming the socle is managed.
        existing = ci.read_text(encoding="utf-8")
        if CI_USES.search(existing):
            staged[".github/workflows/ci.yml"] = (CI_USES.sub(rf"\g<1>{sha} # {tag}", existing), False)
    return staged


def plan(decl: Declarations, staged: dict[str, tuple[str, bool]], apply: bool) -> list[dict]:
    """One entry per managed file: create, update or same; written when applying."""
    files: list[dict] = []
    for relative in MANAGED:
        if relative not in staged:
            continue
        content, executable = staged[relative]
        path = decl.project / relative
        entry: dict = {"path": relative}
        if not path.is_file():
            entry["action"] = "create"
        else:
            current = path.read_text(encoding="utf-8")
            if current != content:
                entry["action"] = "update"
                entry["diff"] = "".join(difflib.unified_diff(
                    current.splitlines(keepends=True), content.splitlines(keepends=True), relative, relative))
            elif executable and not os.access(path, os.X_OK):
                entry["action"] = "update"
                entry["reason"] = "not executable"
            else:
                entry["action"] = "same"
        if apply and entry["action"] != "same":
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content, encoding="utf-8")
            if executable:
                path.chmod(path.stat().st_mode | 0o111)
        files.append(entry)
    return files


def pinned_socle(project: pathlib.Path) -> dict | None:
    """The socle sha and tag the product's release.yml pins, if any."""
    workflow = project / ".github" / "workflows" / "release.yml"
    if not workflow.is_file():
        return None
    match = re.search(rf"{re.escape(SOCLE_REPOSITORY)}/\.github/workflows/release\.yml@([0-9a-f]{{40}}) # (\S+)",
                      workflow.read_text(encoding="utf-8"))
    return {"sha": match.group(1), "tag": match.group(2)} if match else None


def socle_data(sha: str, tag: str) -> dict:
    return {"version": socle_version(), "tag": tag, "sha": sha}


def pinned_socle_checkout(sha: str) -> pathlib.Path:
    """A checkout of the socle at `sha`, fetched once into the user's cache."""
    cache = pathlib.Path(os.environ.get("XDG_CACHE_HOME") or pathlib.Path.home() / ".cache") / "maelys-release" / sha
    if not (cache / "bin" / "maelys-release").is_file():
        base = os.environ.get("MAELYS_GIT_BASE", "https://github.com/maelys-dev")
        cache.parent.mkdir(parents=True, exist_ok=True)
        git("init", "-q", str(cache))
        git("fetch", "-q", "--depth", "1", f"{base}/maelys-release.git", sha, cwd=cache)
        git("checkout", "-q", "FETCH_HEAD", cwd=cache)
        (cache / "bin" / "maelys-release").chmod(0o755)
    return cache


def run_pinned_socle(invocation: Invocation, project: pathlib.Path) -> None:
    """Hand the invocation to the socle the product pins, when this is another one.

    A product's CI fetches the pinned socle itself; a developer's sibling
    checkout drifts as soon as anyone moves it. check, preflight and
    rehearse therefore re-execute themselves from a cached checkout at the
    pinned commit, so the answer is always the pinned socle's. adopt does
    not: moving the pin is exactly its purpose. MAELYS_RELEASE_NO_RELOCATE=1
    keeps the running socle, and --socle-sha names one explicitly.
    """
    if invocation.option("--socle-sha") or os.environ.get("MAELYS_RELEASE_NO_RELOCATE") == "1":
        return
    pinned = pinned_socle(project)
    if not pinned:
        return
    root = socle_root()
    if (root / ".git").exists() and git("rev-parse", "HEAD", cwd=root, check=False) == pinned["sha"]:
        return
    try:
        checkout = pinned_socle_checkout(pinned["sha"])
    except Failure as failure:
        raise Failure("PRECONDITION_FAILED",
                      f"{project.name} pins maelys-release {pinned['tag']} ({pinned['sha'][:7]}) but this is another"
                      f" socle, and the pinned one could not be fetched: {failure.message}",
                      "Check out the pinned tag, or set MAELYS_RELEASE_NO_RELOCATE=1 to run this socle anyway.") from failure
    if invocation.format == "text":
        print(f"note     running the pinned socle {pinned['tag']} ({pinned['sha'][:7]}) from {checkout}", file=sys.stderr)
        sys.stderr.flush()
    sys.stdout.flush()
    environment = {**os.environ, "MAELYS_RELEASE_NO_RELOCATE": "1"}
    os.execve(str(checkout / "bin" / "maelys-release"), [PROGRAM, *sys.argv[1:]], environment)


# ---- handlers: each returns (data, exit code) ---------------------------------

def handle_adopt(invocation: Invocation) -> tuple[dict, int]:
    project, product = project_of(invocation)
    apply = invocation.flag("--apply")
    decl = read_declarations(project, product)
    require_valid(decl, "adopt")
    sha, tag = socle_identity(str(invocation.option("--socle-sha", "")), str(invocation.option("--socle-tag", "")))
    # A product pins releases of the socle: a commit without a tag has no
    # changelog entry, no trial and no compatibility promise. Trials of a
    # candidate say so explicitly.
    if tag == "untagged" and not invocation.option("--socle-sha") and not invocation.flag("--allow-untagged"):
        described = git("describe", "--tags", "--always", cwd=socle_root(), check=False) or sha[:7]
        raise Failure("PRECONDITION_FAILED", f"This socle is {described}, not a release: a product pins tagged versions only.",
                      "Check out a tag of maelys-release, or pass --allow-untagged for a trial of a candidate.")
    files = plan(decl, stage(decl, sha, tag), apply)
    changed = any(entry["action"] != "same" for entry in files)
    return {"mode": "apply" if apply else "plan", "product": product, "project": str(project),
            "socle": socle_data(sha, tag), "changed": changed, "checks": decl.checks, "files": files}, EXIT_OK


def check_data(invocation: Invocation) -> tuple[Declarations, dict]:
    project, product = project_of(invocation)
    run_pinned_socle(invocation, project)
    decl = read_declarations(project, product)
    sha, tag = socle_identity(str(invocation.option("--socle-sha", "")), str(invocation.option("--socle-tag", "")))
    pinned = pinned_socle(project)
    # A socle fetched by commit alone (a depth-1 fetch in CI) knows no tag;
    # the tag is only a label next to the pinned commit, so when the commits
    # agree the product's label stands and regeneration compares content.
    if tag == "untagged" and pinned and pinned["sha"] == sha:
        tag = pinned["tag"]
    data: dict = {"product": product, "project": str(project), "socle": socle_data(sha, tag),
                  "pinned": pinned, "checks": decl.checks, "files": [], "violations": []}
    data["violations"].extend(check["message"] for check in decl.checks if check["status"] not in ("ok", "note"))
    if decl.valid:
        if data["pinned"] and data["pinned"]["sha"] != sha:
            data["violations"].append(
                f"{product} pins maelys-release {data['pinned']['tag']} ({data['pinned']['sha'][:7]}) but this is"
                f" {tag} ({sha[:7]}): run the pinned socle, or 'adopt {project} --apply' from this one to upgrade")
        else:
            data["files"] = plan(decl, stage(decl, sha, tag), apply=False)
            data["violations"].extend(f"{entry['path']}: {entry['action']}" + (f" ({entry['reason']})" if "reason" in entry else "")
                                      for entry in data["files"] if entry["action"] != "same")
    data["valid"] = not data["violations"]
    return decl, data


def handle_declarations(invocation: Invocation) -> tuple[dict, int]:
    """The product contract as data, for a CI job that installs what it declares."""
    project, product = project_of(invocation)
    decl = read_declarations(project, product)
    return {"valid": decl.valid, "product": product, "project": str(project), "version": decl.version,
            "dependencies": decl.dependencies, "linuxPackages": decl.linux_packages,
            "macosPackages": decl.macos_packages, "formulas": decl.formulas, "checks": decl.checks}, \
        EXIT_OK if decl.valid else EXIT_VIOLATIONS


def handle_check(invocation: Invocation) -> tuple[dict, int]:
    _, data = check_data(invocation)
    return data, EXIT_OK if data["valid"] else EXIT_VIOLATIONS


def github_api(path: str) -> dict | None:
    """GET through gh (its credentials); None when gh is missing or the call fails."""
    if not shutil.which("gh"):
        return None
    completed = run(["gh", "api", path])
    return json.loads(completed.stdout) if completed.returncode == 0 else None


def handle_preflight(invocation: Invocation) -> tuple[dict, int]:
    """What the release workflow will demand of the tag, before it exists."""
    decl, data = check_data(invocation)
    project = decl.project
    preflight: list[dict] = []

    def add(status: str, message: str) -> None:
        preflight.append({"status": status, "message": message})

    def config(key: str) -> str:
        return git("config", "--get", key, cwd=project, check=False)

    if data["valid"]:
        add("ok" if config("tag.gpgsign") == "true" else "fail",
            "tag.gpgsign = true" if config("tag.gpgsign") == "true" else "tag.gpgsign is not true: git config tag.gpgsign true")
        fmt = config("gpg.format") or "openpgp"
        if config("user.signingkey"):
            add("ok", f"gpg.format = {fmt}, user.signingkey set")
        else:
            add("fail", f"user.signingkey is not set (gpg.format = {fmt}); the key must be registered on GitHub")
        if git("rev-parse", "--is-shallow-repository", cwd=project, check=False) == "true":
            add("fail", "shallow clone: previous tags are not visible; run from a full clone")
        else:
            tags = git("tag", "--list", "v*", "--sort=-v:refname", cwd=project, check=False).split()
            if not tags:
                add("note", "no v* tag yet")
            else:
                last = tags[0]
                if git("cat-file", "-t", last, cwd=project, check=False) != "tag":
                    add("fail", f"{last} is a lightweight tag; the workflow requires annotated signed tags")
                elif not re.search(r"-----BEGIN .*SIGNATURE-----", git("cat-file", "-p", last, cwd=project, check=False)):
                    add("fail", f"{last} is not signed")
                else:
                    add("ok", f"{last} is annotated and signed")
        if git("rev-parse", "-q", "--verify", f"refs/tags/v{decl.version}", cwd=project, check=False):
            add("fail", f"tag v{decl.version} already exists; bump VERSION")
        else:
            add("ok", f"tag v{decl.version} is free")
        # GitHub creates a missing environment on first use, without rules,
        # so presence proves nothing: the environment must limit deployments
        # to tags v*, which keeps a workflow_dispatch from a branch or a
        # release.yml edited on a branch from publishing.
        remote = git("remote", "get-url", "origin", cwd=project, check=False)
        match = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?$", remote)
        if not match:
            add("note", "origin is not on GitHub: release environment not checked")
        elif not shutil.which("gh"):
            add("note", f"gh is not installed: release environment of {match.group(1)} not checked")
        else:
            repository = match.group(1)
            repository_data = github_api(f"repos/{repository}") or {}
            if repository_data.get("private"):
                add("note", f"{repository} is private: the release ships no provenance attestation (GitHub reserves"
                    " them to paid plans); the signed tag and SHA256SUMS remain")
            environment = github_api(f"repos/{repository}/environments/release")
            if environment is None:
                add("fail", f"environment release is missing in {repository}; create it and limit its deployments to tags v*")
            elif not (environment.get("deployment_branch_policy") or {}).get("custom_branch_policies"):
                add("fail", f"environment release of {repository} has no deployment policy: any branch,"
                    " workflow_dispatch or edited release.yml can publish; limit it to tags v*")
            else:
                policies = github_api(f"repos/{repository}/environments/release/deployment-branch-policies") or {}
                if any(policy.get("type") == "tag" and policy.get("name") == "v*"
                       for policy in policies.get("branch_policies", [])):
                    add("ok", f"environment release of {repository} limits deployments to tags v*")
                else:
                    add("fail", f"environment release of {repository} has a deployment policy without the tag rule v*")
    data["preflight"] = preflight
    data["violations"].extend(item["message"] for item in preflight if item["status"] == "fail")
    data["ready"] = data["valid"] and not any(item["status"] == "fail" for item in preflight)
    return data, EXIT_OK if data["ready"] else EXIT_VIOLATIONS


REHEARSAL = r"""
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
echo "== Install Linux packaging tools and declared packages"
apt-get update -q >/dev/null
# git and certificates are on the runner already; the image has neither.
apt-get install -y -q --no-install-recommends git ca-certificates $LINUX_PACKAGES >/dev/null
echo "== Copy the working tree (dist/ excluded)"
mkdir -p /work/product && cd /work/product
tar -C /src --exclude=./dist -cf - . | tar -xf -
git config --global --add safe.directory "*"
echo "== Pinned dependency checkouts"
for name in $DEPENDENCIES; do sh scripts/checkout-dependency.sh "$name"; done
if [ "$REHEARSE_MODE" = check ]; then
    echo "== Check: $CHECK_COMMAND"
    eval "$CHECK_COMMAND"
    exit 0
fi
echo "== Package: ${PACKAGE_COMMAND//TARGET/$TARGET}"
eval "${PACKAGE_COMMAND//TARGET/$TARGET}"
test -n "$(ls dist 2>/dev/null)" || { echo "rehearse: dist/ is empty" >&2; exit 1; }
cp dist/* /dist/
echo "== Artifacts in dist/"
ls -l /dist
"""


def handle_rehearse(invocation: Invocation) -> tuple[dict, int]:
    """Replay the build job of release.yml for one Linux target in Docker."""
    project, product = project_of(invocation)
    run_pinned_socle(invocation, project)
    target = invocation.operands[1]
    if not shutil.which("docker"):
        raise Failure("NOT_FOUND", "docker is required to rehearse a Linux build.", "Install Docker and retry.")
    decl = read_declarations(project, product)
    require_valid(decl, "rehearse")
    if decl.dependencies and not os.access(project / "scripts" / "checkout-dependency.sh", os.X_OK):
        raise Failure("PRECONDITION_FAILED", "scripts/checkout-dependency.sh is missing in the product.",
                      f"Run '{PROGRAM} adopt {project} --apply' first.")
    (project / "dist").mkdir(exist_ok=True)
    image = str(invocation.option("--image", os.environ.get("REHEARSE_IMAGE", DEFAULT_IMAGE)))
    package_command = str(invocation.option("--package-command", "bash scripts/package-release.sh TARGET"))
    mode = "check" if invocation.flag("--check") else "package"
    check_command = str(invocation.option("--check-command", "make check"))
    command = ["docker", "run", f"--name=rehearse-{target}" if invocation.flag("--keep") else "--rm",
               "--platform", PLATFORMS[target],
               "-v", f"{project}:/src:ro", "-v", f"{project / 'dist'}:/dist",
               "-e", f"TARGET={target}",
               "-e", f"LINUX_PACKAGES={SOCLE_LINUX_PACKAGES} {decl.linux_packages}".rstrip(),
               "-e", f"DEPENDENCIES={' '.join(decl.dependencies)}",
               "-e", f"PACKAGE_COMMAND={package_command}",
               "-e", f"REHEARSE_MODE={mode}", "-e", f"CHECK_COMMAND={check_command}",
               image, "bash", "-c", REHEARSAL]
    # The container's output is a log: it stays on stdout for a human and
    # moves to stderr when the envelope owns stdout.
    log = sys.stderr if invocation.format != "text" else sys.stdout
    print(f"rehearse: {mode} {target} on {image} ({PLATFORMS[target]})", file=log)
    log.flush()
    completed = subprocess.run(command, check=False, stdout=log, stderr=subprocess.STDOUT)
    if completed.returncode != 0:
        raise Failure("PROCESS_FAILED", f"The rehearsal of {target} failed with exit {completed.returncode}.",
                      "Read the container log above; fix the product and retry.")
    artifacts = [] if mode == "check" else sorted(path.name for path in (project / "dist").iterdir() if target in path.name)
    return {"product": product, "target": target, "platform": PLATFORMS[target], "image": image, "mode": mode,
            "artifacts": artifacts}, EXIT_OK


def handle_render(invocation: Invocation) -> tuple[dict, int]:
    template, output = pathlib.Path(invocation.operands[0]), pathlib.Path(invocation.operands[1])
    mapping: dict[str, str] = {}
    for pair in invocation.operands[2:]:
        key, separator, value = pair.partition("=")
        if not separator or not re.fullmatch(r"[A-Z0-9_]+", key):
            raise Failure("VALIDATION_FAILED", f"Placeholder assignments are KEY=VALUE with KEY in [A-Z0-9_]: {pair}.",
                          "Use the synopsis returned by describe and retry.")
        mapping[key] = value
    if not template.is_file():
        raise Failure("NOT_FOUND", f"Template not found: {template}.", "Pass an existing template file.")
    text = render_text(template, mapping)
    left = sorted(set(re.findall(r"@[A-Z0-9_]*@", text)))
    if left:
        raise Failure("VALIDATION_FAILED", f"Unrendered placeholders in {template}: {' '.join(left)}.",
                      "Pass a KEY=VALUE for each of them.")
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(text, encoding="utf-8")
    return {"template": str(template), "output": str(output), "placeholders": sorted(mapping)}, EXIT_OK


def handle_tap(invocation: Invocation) -> tuple[dict, int]:
    """Plan or publish one rendered formula into the tap with a signed commit."""
    product, tag, formula = invocation.operands[0], invocation.operands[1], pathlib.Path(invocation.operands[2])
    apply = invocation.flag("--apply")
    if not re.fullmatch(r"v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?", tag):
        raise Failure("VALIDATION_FAILED", f"TAG is vX.Y.Z or vX.Y.Z-PRERELEASE: {tag}.", "Pass the release tag.")
    if not formula.is_file():
        raise Failure("NOT_FOUND", f"Rendered formula not found: {formula}.", "Render the formula first.")
    version = tag[1:]
    repository = os.environ.get("TAP_REPOSITORY", DEFAULT_TAP)
    token = os.environ.get("TAP_TOKEN", "")
    url = os.environ.get("TAP_URL") or (
        f"https://x-access-token:{token}@github.com/{repository}.git" if token
        else f"https://github.com/{repository}.git")
    owner, _, name = repository.partition("/")
    data: dict = {"mode": "apply" if apply else "plan", "product": product, "version": version,
                  "repository": repository, "formula": f"Formula/{product}.rb", "changed": False}
    with tempfile.TemporaryDirectory(prefix="maelys-release-tap.") as temp:
        tap = pathlib.Path(temp) / "tap"
        git("clone", "-q", url, str(tap))
        (tap / "Formula").mkdir(exist_ok=True)
        shutil.copyfile(formula, tap / "Formula" / f"{product}.rb")
        if shutil.which("brew") and not invocation.flag("--skip-style"):
            style = run(["brew", "style", str(tap / "Formula" / f"{product}.rb")])
            if style.returncode != 0:
                raise Failure("VALIDATION_FAILED", f"brew style refused the formula: {style.stdout.strip()}",
                              "Fix the formula template and render it again.")
        git("add", f"Formula/{product}.rb", cwd=tap)
        if run(["git", "diff", "--cached", "--quiet"], cwd=tap).returncode == 0:
            return data, EXIT_OK
        data["changed"] = True
        data["diff"] = git("diff", "--cached", cwd=tap)
        if not apply:
            return data, EXIT_OK
        sign: list[str] = []
        key = os.environ.get("TAP_SIGNING_KEY", "")
        if key:
            key_file = pathlib.Path(temp) / "signing-key"
            key_file.write_text(key + "\n", encoding="utf-8")
            key_file.chmod(0o600)
            sign = ["-c", "gpg.format=ssh", "-c", f"user.signingkey={key_file}", "-c", "commit.gpgsign=true"]
        author = os.environ.get("GIT_AUTHOR_NAME", PROGRAM)
        email = os.environ.get("GIT_AUTHOR_EMAIL", f"{PROGRAM}@users.noreply.github.com")
        git(*sign, "-c", f"user.name={author}", "-c", f"user.email={email}",
            "commit", "-q", "-m", f"Update {product} to {version}", cwd=tap)
        data["commit"] = git("rev-parse", "HEAD", cwd=tap)
        git("push", "-q", "origin", "HEAD:main", cwd=tap)
    data["install"] = f"brew install {owner}/{name.replace('homebrew-', '', 1)}/{product}"
    return data, EXIT_OK


def handle_self_test(invocation: Invocation) -> tuple[dict, int]:
    tests = socle_root() / "tests"
    if not tests.is_dir():
        raise Failure("NOT_FOUND", f"{tests} is not part of this installation.", "Run from a maelys-release checkout.")
    command = [sys.executable, "-W", "error", "-m", "unittest", "discover", "-s", str(tests)]
    if invocation.flag("--verbose"):
        command.append("-v")
    log = sys.stderr if invocation.format != "text" else sys.stdout
    log.flush()
    completed = subprocess.run(command, check=False, stdout=log, stderr=subprocess.STDOUT)
    if completed.returncode != 0:
        raise Failure("PROCESS_FAILED", f"The self-test failed with exit {completed.returncode}.", "Read the report above.")
    return {"tests": str(tests), "passed": True}, EXIT_OK


# ---- the vendored framework ---------------------------------------------------

def vendored_pin() -> tuple[str, str, str]:
    """(tag, commit, sha256) of dependencies/maelys-cli.pin; the third line may be absent."""
    lines = (socle_root() / "dependencies" / "maelys-cli.pin").read_text(encoding="utf-8").split()
    digest = lines[2].partition(":")[2] if len(lines) > 2 else ""
    return lines[0], lines[1], digest


def handle_vendor(invocation: Invocation) -> tuple[dict, int]:
    """Refresh bin/maelys_cli.py from maelys-cli at the pinned commit, and record its digest."""
    del invocation
    tag, commit, previous = vendored_pin()
    base = os.environ.get("MAELYS_GIT_BASE", "https://github.com/maelys-dev")
    with tempfile.TemporaryDirectory(prefix="maelys-release-vendor.") as temp:
        work = pathlib.Path(temp)
        git("init", "-q", str(work))
        git("fetch", "-q", "--depth", "1", f"{base}/maelys-cli.git", commit, cwd=work)
        shown = run(["git", "show", "FETCH_HEAD:python/maelys_cli.py"], cwd=work)
        if shown.returncode != 0:
            raise Failure("NOT_FOUND", f"python/maelys_cli.py is not in maelys-cli at {commit[:7]}.",
                          "Pin a maelys-cli release that ships the Python framework (0.5.12 or later).")
        content = shown.stdout.encode("utf-8")
    digest = hashlib.sha256(content).hexdigest()
    target = socle_root() / "bin" / "maelys_cli.py"
    changed = not target.is_file() or target.read_bytes() != content or previous != digest
    target.write_bytes(content)
    (socle_root() / "dependencies" / "maelys-cli.pin").write_text(f"{tag}\n{commit}\nsha256:{digest}\n", encoding="utf-8")
    return {"tag": tag, "commit": commit, "sha256": digest, "path": str(target), "changed": changed}, EXIT_OK


# ---- text renderers ----------------------------------------------------------

LABELS = {"ok": "ok", "note": "note", "warn": "WARN", "missing": "MISSING", "refused": "REFUSED", "fail": "FAIL"}


def checks_text(checks: list[dict]) -> str:
    return "".join(f"{LABELS.get(check['status'], check['status']):<8} {check['message']}\n" for check in checks)


def text_adopt(data: dict) -> str:
    lines = []
    for entry in data["files"]:
        lines.append(f"{entry['action']:<8} {entry['path']}" + (f" ({entry['reason']})" if "reason" in entry else ""))
        if data["mode"] == "plan" and entry.get("diff"):
            lines.extend("         " + line for line in entry["diff"].rstrip("\n").split("\n"))
    tag = data["socle"]["tag"]
    if data["mode"] == "apply":
        lines.append(f"adopt: wrote maelys-release {tag} into {data['project']}")
    elif data["changed"]:
        lines.append("adopt: plan only; add --apply to write")
    else:
        lines.append("adopt: nothing to do")
    return checks_text(data["checks"]) + "\n".join(lines) + "\n"


def text_check(data: dict, with_checks: bool = True) -> str:
    lines = [f"{entry['action']:<8} {entry['path']}" + (f" ({entry['reason']})" if "reason" in entry else "")
             for entry in data["files"]]
    if data["valid"]:
        lines.append(f"check: {data['product']} is on maelys-release {data['socle']['tag']}")
    else:
        # the contract lines and the file lines already show their violations
        shown = {check["message"] for check in data["checks"]}
        shown.update(f"{entry['path']}: {entry['action']}" + (f" ({entry['reason']})" if "reason" in entry else "")
                     for entry in data["files"])
        lines.extend(f"drift    {violation}" for violation in data["violations"] if violation not in shown)
        lines.append(f"check: {data['product']} drifts from maelys-release {data['socle']['tag']}")
    return (checks_text(data["checks"]) if with_checks else "") + "\n".join(lines) + "\n"


def text_preflight(data: dict) -> str:
    # the check part first, with its drift lines when it fails; then the tag preconditions
    lines = [text_check(data).rstrip("\n")]
    lines.extend(f"{LABELS[item['status']]:<8} {item['message']}" for item in data["preflight"])
    state = "ready to tag" if data["ready"] else "not ready to tag"
    lines.append(f"preflight: {data['product']} is {state}")
    return "\n".join(lines) + "\n"


def text_declarations(data: dict) -> str:
    return checks_text(data["checks"]) + "".join(f"{key:<13} {value}\n" for key, value in (
        ("dependencies", " ".join(data["dependencies"])), ("linux", data["linuxPackages"]),
        ("macos", data["macosPackages"]), ("formulas", " ".join(data["formulas"]))))


def text_tap(data: dict) -> str:
    if not data["changed"]:
        return f"tap already carries {data['product']} {data['version']}\n"
    if data["mode"] == "plan":
        return data["diff"] + "\ntap: plan only; add --apply to commit and push\n"
    return f"{data['install']}\n"


TEXT = {
    "adopt": text_adopt,
    "check": text_check,
    "declarations": text_declarations,
    "preflight": text_preflight,
    "rehearse": lambda data: (f"rehearse: {data['target']} built " + ", ".join(data["artifacts"]) + "\n"
                              if data["mode"] == "package" else f"rehearse: check passed on {data['target']}\n"),
    "render": lambda data: f"rendered {data['output']}\n",
    "tap": text_tap,
    "self-test": lambda data: "self-test: ok\n",
    "vendor": lambda data: (f"vendor: bin/maelys_cli.py is maelys-cli {data['tag']} ({data['commit'][:7]}),"
                            f" sha256 {data['sha256'][:12]}, " + ("updated" if data["changed"] else "unchanged") + "\n"),
}


# ---- the catalog --------------------------------------------------------------

CHECKS_SCHEMA = {"type": "array", "items": {"type": "object", "required": ["status", "message"],
                                           "properties": {"status": {"type": "string"}, "message": {"type": "string"}}}}
FILES_SCHEMA = {"type": "array", "items": {"type": "object", "required": ["path", "action"],
                                          "properties": {"path": {"type": "string"},
                                                         "action": {"enum": ["create", "update", "same"]},
                                                         "diff": {"type": "string"}, "reason": {"type": "string"}}}}
SOCLE_SCHEMA = {"type": "object", "required": ["version", "tag", "sha"],
                "properties": {"version": {"type": "string"}, "tag": {"type": "string"}, "sha": {"type": "string"}}}
STRINGS = {"type": "array", "items": {"type": "string"}}
SOCLE_OPTIONS = (
    cli.option("--product", "Product name; defaults to the directory name.", cli.argument("NAME")),
    cli.option("--socle-sha", "Socle commit to pin instead of this checkout's HEAD (trials and tests).",
               cli.argument("SHA", "string", pattern="^[0-9a-f]{40}$"), hidden=True),
    cli.option("--socle-tag", "Socle tag written next to --socle-sha.", cli.argument("TAG"), hidden=True),
)
DIR_OPERAND = cli.operand("DIR", "Product repository.")
CHECK_SCHEMA = {"type": "object", "additionalProperties": False,
                "required": ["valid", "product", "project", "socle", "pinned", "checks", "files", "violations"],
                "properties": {"valid": {"type": "boolean"}, "product": {"type": "string"},
                               "project": {"type": "string"}, "socle": SOCLE_SCHEMA,
                               "pinned": {"type": ["object", "null"]}, "checks": CHECKS_SCHEMA,
                               "files": FILES_SCHEMA, "violations": STRINGS}}

APP = cli.Program(PROGRAM, PRODUCT, socle_version(), [
    cli.transaction("adopt", "adopt", "Write the managed files of the socle into a product; plan without --apply.",
                    handle_adopt, operands=[DIR_OPERAND],
                    options=[*SOCLE_OPTIONS,
                             cli.flag("--allow-untagged", "Accept a socle commit without a tag (a trial of a candidate).")],
                    schema={"type": "object", "additionalProperties": False,
                            "required": ["mode", "product", "project", "socle", "changed", "checks", "files"],
                            "properties": {"mode": {"enum": ["plan", "apply"]}, "product": {"type": "string"},
                                           "project": {"type": "string"}, "socle": SOCLE_SCHEMA,
                                           "changed": {"type": "boolean"}, "checks": CHECKS_SCHEMA, "files": FILES_SCHEMA}}),
    cli.read("check", "check", "Report the product contract and the drift of the managed files; exit 2 on any violation.",
             handle_check, operands=[DIR_OPERAND], options=list(SOCLE_OPTIONS), schema=CHECK_SCHEMA),
    cli.read("declarations", "declarations",
             "Return the product contract as data: pinned dependencies, packages, formulas; exit 2 when invalid.",
             handle_declarations, operands=[DIR_OPERAND], options=[SOCLE_OPTIONS[0]],
             schema={"type": "object", "additionalProperties": False,
                     "required": ["valid", "product", "project", "version", "dependencies", "linuxPackages",
                                  "macosPackages", "formulas", "checks"],
                     "properties": {"valid": {"type": "boolean"}, "product": {"type": "string"},
                                    "project": {"type": "string"}, "version": {"type": "string"},
                                    "dependencies": STRINGS, "linuxPackages": {"type": "string"},
                                    "macosPackages": {"type": "string"}, "formulas": STRINGS, "checks": CHECKS_SCHEMA}}),
    cli.read("preflight", "preflight",
             "Check, then report what the release workflow would refuse of the next tag; exit 2 when not ready.",
             handle_preflight, operands=[DIR_OPERAND], options=list(SOCLE_OPTIONS),
             schema={"type": "object", "additionalProperties": False,
                     "required": ["ready", "valid", "product", "project", "socle", "pinned", "checks", "files",
                                  "preflight", "violations"],
                     "properties": {"ready": {"type": "boolean"}, "valid": {"type": "boolean"},
                                    "product": {"type": "string"}, "project": {"type": "string"},
                                    "socle": SOCLE_SCHEMA, "pinned": {"type": ["object", "null"]},
                                    "checks": CHECKS_SCHEMA, "files": FILES_SCHEMA,
                                    "preflight": CHECKS_SCHEMA, "violations": STRINGS}}),
    cli.execute("rehearse", "rehearse",
                "Replay the Linux build job of the release, or make check with --check, in a Docker container on a copy of the working tree.",
                handle_rehearse,
                operands=[DIR_OPERAND, cli.operand("TARGET", "linux-x86_64 or linux-arm64.", choices=list(PLATFORMS))],
                options=[*SOCLE_OPTIONS,
                         cli.option("--image", "Container image.", cli.argument("IMAGE"), default=DEFAULT_IMAGE),
                         cli.option("--package-command", "Command producing dist/; TARGET is substituted.",
                                    cli.argument("COMMAND"), default="bash scripts/package-release.sh TARGET"),
                         cli.flag("--check", "Run the check command instead of packaging; dist/ is left alone."),
                         cli.option("--check-command", "Command run with --check.", cli.argument("COMMAND"), default="make check"),
                         cli.flag("--keep", "Keep the container for inspection.")],
                schema={"type": "object", "additionalProperties": False,
                        "required": ["product", "target", "platform", "image", "mode", "artifacts"],
                        "properties": {"product": {"type": "string"}, "target": {"type": "string"},
                                       "platform": {"type": "string"}, "image": {"type": "string"},
                                       "mode": {"enum": ["package", "check"]}, "artifacts": STRINGS}}),
    cli.execute("render", "render", "Replace @KEY@ placeholders of a template, refusing to leave one unrendered.",
                handle_render,
                operands=[cli.operand("TEMPLATE", "Template file."), cli.operand("OUTPUT", "File written."),
                          cli.operand("KEY=VALUE", "Placeholder values.", required=False, variadic=True)],
                schema={"type": "object", "additionalProperties": False, "required": ["template", "output", "placeholders"],
                        "properties": {"template": {"type": "string"}, "output": {"type": "string"}, "placeholders": STRINGS}}),
    cli.transaction("tap", "tap", "Publish a rendered formula into the Homebrew tap with a signed commit; plan without --apply.",
                    handle_tap, commit=True,
                    operands=[cli.operand("PRODUCT", "Formula name."), cli.operand("TAG", "Release tag vX.Y.Z."),
                              cli.operand("FORMULA", "Rendered formula file.")],
                    options=[cli.flag("--skip-style", "Do not run brew style.")],
                    schema={"type": "object", "additionalProperties": False,
                            "required": ["mode", "product", "version", "repository", "formula", "changed"],
                            "properties": {"mode": {"enum": ["plan", "apply"]}, "product": {"type": "string"},
                                           "version": {"type": "string"}, "repository": {"type": "string"},
                                           "formula": {"type": "string"}, "changed": {"type": "boolean"},
                                           "diff": {"type": "string"}, "commit": {"type": "string"}, "install": {"type": "string"}}}),
    cli.execute("self-test", "self-test", "Run the socle's own tests.", handle_self_test,
                options=[cli.flag("--verbose", "Report every test.")],
                schema={"type": "object", "additionalProperties": False, "required": ["tests", "passed"],
                        "properties": {"tests": {"type": "string"}, "passed": {"type": "boolean"}}}),
    cli.execute("vendor", "vendor", "Refresh bin/maelys_cli.py from maelys-cli at dependencies/maelys-cli.pin and record its digest.",
                handle_vendor,
                schema={"type": "object", "additionalProperties": False,
                        "required": ["tag", "commit", "sha256", "path", "changed"],
                        "properties": {"tag": {"type": "string"}, "commit": {"type": "string"}, "sha256": {"type": "string"},
                                       "path": {"type": "string"}, "changed": {"type": "boolean"}}}),
], guide="release socle of the Maelys repositories", text=TEXT)


if __name__ == "__main__":
    sys.exit(APP.main())
