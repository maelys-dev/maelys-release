#!/usr/bin/env python3
# SPDX-License-Identifier: MPL-2.0
"""maelys-release: adopt, check, rehearse and publish through the Maelys
release socle.

A command-line program of the agent-cli/v2 contract, built on maelys_cli,
the Python framework of maelys-cli: bin/maelys_cli.py is that framework's
python/maelys_cli.py at the commit dependencies/maelys-cli.pin names, byte for
byte, and `maelys-release vendor` refreshes it. One catalog drives the
parser, help, describe and completion; success is a JSON envelope on
stdout, failure an envelope on stderr; exit 0 completed, 1 failed, 2 a
validation that found violations. Transactional commands (adopt, tap) plan
by default and write with --apply.

Standard library only; python3 >= 3.9. The socle is the checkout (or the
installed prefix) this file runs from: share/ holds the texts installed
into products, VERSION its version.

This file is the entry point and nothing else. The package beside it,
maelys_socle, holds every command: `cli/` the program, its catalog, its
schemas and its text; `commands/` and the modules beside it what each
command does; `host` and `forge` the one boundary to processes and to the
service that hosts a repository. What only this file can know is where the
socle it belongs to stands -- an installed copy and a checkout loaded in one
interpreter share the package -- and it hands that to the package as a
context.
"""
from __future__ import annotations

import pathlib
import re
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import maelys_cli as cli  # noqa: E402

from maelys_socle import identity  # noqa: E402
from maelys_socle.cli import catalog  # noqa: E402
from maelys_socle.context import Context  # noqa: E402


# ---- the socle this entry point runs from --------------------------------------

def socle_root() -> pathlib.Path:
    return pathlib.Path(__file__).resolve().parent.parent


def socle_version() -> str:
    for candidate in (socle_root() / "VERSION", identity.share_dir(socle_root()) / "VERSION"):
        if candidate.is_file():
            version = candidate.read_text(encoding="utf-8").strip()
            if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", version):
                raise cli.Failure("PRECONDITION_FAILED", f"The socle's VERSION is not X.Y.Z: {version!r}.",
                                  "Fix VERSION of the socle; nothing generated from it can be trusted.")
            return version
    raise cli.Failure("NOT_FOUND", "VERSION of the socle not found.", "Run from a maelys-release checkout.")


CONTEXT = Context(socle_root=socle_root, socle_version=socle_version)
APP = catalog.build(CONTEXT)


if __name__ == "__main__":
    sys.exit(APP.main())
