    cli.option("--product", "Product name; defaults to the directory name.", cli.argument("NAME")),
    cli.option("--socle-sha", "Socle commit to pin instead of this checkout's HEAD (trials and tests).",
               cli.argument("SHA", "string", pattern="^[0-9a-f]{40}$"), hidden=True),
    cli.option("--socle-tag", "Socle tag written next to --socle-sha.", cli.argument("TAG"), hidden=True),
)
DIR_OPERAND = cli.operand("DIR", "Product repository.")
CHECK_SCHEMA = {"type": "object", "additionalProperties": False,
                "required": ["valid", "product", "project", "mechanism", "socle", "pinned", "checks", "files",
                             "violations", "conventions", "release"],
                "properties": {"valid": {"type": "boolean"}, "product": {"type": "string"},
                               "project": {"type": "string"}, "mechanism": MECHANISM_SCHEMA,
                               "socle": SOCLE_SCHEMA,
                               "pinned": {"type": ["object", "null"]}, "checks": CHECKS_SCHEMA,
                               "files": FILES_SCHEMA, "violations": STRINGS,
                               "conventions": VERDICT_SCHEMA, "release": VERDICT_SCHEMA}}
CUT_SCHEMA = {"type": "object", "additionalProperties": False,
              "required": ["mode", "stage", "product", "project", "repository", "version", "tag", "branch",
                           "base", "gate", "checks", "ready"],
              "properties": {"mode": {"enum": ["plan", "apply"]}, "stage": {"enum": ["open", "tag"]},
                             "product": {"type": "string"}, "project": {"type": "string"},
                             "repository": {"type": "string"}, "version": {"type": "string"},
                             "previousVersion": {"type": "string"}, "tag": {"type": "string"},
                             "branch": {"type": "string"}, "base": {"type": "string"},
                             "changelog": {"type": "string"},
                             "gate": {"type": "array", "items": {
                                 "type": "object", "additionalProperties": False, "required": ["status", "message"],
                                 "properties": {"status": {"type": "string"}, "message": {"type": "string"}}}},
                             "checks": {"type": "array", "items": {
                                 "type": "object", "additionalProperties": False,
                                 "required": ["name", "status", "conclusion"],
                                 "properties": {"name": {"type": "string"}, "status": {"type": "string"},
                                                "conclusion": {"type": "string"}}}},
                             "ready": {"type": "boolean"}, "commit": {"type": "string"},
                             "pullRequest": {"type": "object", "additionalProperties": False,
                                             "required": ["number", "url", "state"],
                                             "properties": {"number": {"type": "integer"},
                                                            "url": {"type": "string"},
                                                            "state": {"type": "string"}}},
                             "pushed": {"type": "boolean"}, "verified": {"type": "boolean"},
                             "regenerated": STRINGS,
                             "next": {"type": "string"}}}
DOCS_CONTRACT_OPTION = cli.flag(
    "--docs-contract", "Refuse prose in docs/ and a CLI reference outside docs/cli.md, instead of noting them.")
MECHANISM_OPTION = cli.option(
    "--mechanism", "How the product publishes when it carries no release.yml yet.",
    cli.argument("MECHANISM", choices=list(MECHANISMS)))

APP = cli.Program(PROGRAM, PRODUCT, socle_version(), [
    cli.transaction("migrate", "migrate",
                    "Move a product's prose into maelys-docs with its history and out of the product;"
                    " plan without --apply.",
                    handle_migrate, operands=[DIR_OPERAND],
                    options=[SOCLE_OPTIONS[0],
                             cli.option("--documents", "JSONL of the documents to move, '-' for stdin"
                                        " (maelys-platform docs --prose --only PRODUCT --format jsonl).",
                                        cli.argument("FILE"), default="-"),
                             cli.option("--documents-repository", "Repository the prose moves to.",
                                        cli.argument("REPOSITORY"), default=DEFAULT_DOCUMENTS),
                             cli.flag("--push", "Send both branches; without it nothing leaves this machine.")],
                    schema={"type": "object", "additionalProperties": False,
                            "required": ["mode", "product", "project", "repository", "version", "tag", "commit",
                                         "moving", "staying", "documents"],
                            "properties": {"mode": {"enum": ["plan", "apply"]}, "product": {"type": "string"},
                                           "project": {"type": "string"}, "repository": {"type": "string"},
                                           "version": {"type": "string"}, "tag": {"type": "string"},
                                           "commit": {"type": "string"}, "documents": {"type": "integer"},
                                           "moving": {"type": "array", "items": {
                                               "type": "object", "required": ["path", "destination", "referencedBy"],
                                               "properties": {"path": {"type": "string"},
                                                              "destination": {"type": "string"},
                                                              "referencedBy": STRINGS}}},
                                           "staying": {"type": "array", "items": {
                                               "type": "object", "required": ["path", "reason"],
                                               "properties": {"path": {"type": "string"},
                                                              "reason": {"type": "string"}}}},
                                           "readme": {"type": "string"},
                                           "rewritten": STRINGS,
                                           "remaining": {"type": "array", "items": {
                                               "type": "object", "required": ["path", "line", "names"],
                                               "properties": {"path": {"type": "string"},
                                                              "line": {"type": "integer"},
                                                              "names": {"type": "string"}}}},
                                           "globs": {"type": "array", "items": {
                                               "type": "object", "required": ["path", "line", "names"],
                                               "properties": {"path": {"type": "string"},
                                                              "line": {"type": "integer"},
                                                              "names": {"type": "string"}}}},
                                           "documentsBranch": {"type": "string"}, "documentsCommit": {"type": "string"},
                                           "productBranch": {"type": "string"}, "productCommit": {"type": "string"},
                                           "pushed": {"type": "boolean"}, "kept": {"type": "string"}}}),
    cli.transaction("new", "new",
                    "Create a Maelys repository in an empty directory: licence, version, changelog, pins,"
                    " and the files of the socle; plan without --apply.",
                    handle_new,
                    operands=[cli.operand("DIR", "Directory to create the repository in; empty, or absent.")],
                    options=[*SOCLE_OPTIONS, MECHANISM_OPTION,
