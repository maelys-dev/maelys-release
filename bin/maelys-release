#!/usr/bin/env python3
# SPDX-License-Identifier: MPL-2.0
"""maelys-release: adopt, check, rehearse and publish through the Maelys
release socle.

A command-line program of the agent-cli/v2 contract, built on maelys_cli,
the Python framework of maelys-cli: bin/maelys_cli.py is that framework's
python/maelys_cli.py at the commit dependencies/maelys-cli.pin names, byte for
byte, and `maelys-release vendor` refreshes it. One catalog drives the
parser, help, describe and completion; success is a JSON envelope on
stdout, failure an envelope on stderr; exit 0 completed, 1 failed, 2 a
validation that found violations. Transactional commands (adopt, tap) plan
by default and write with --apply.

Standard library only; python3 >= 3.9. The socle is the checkout (or the
installed prefix) this file runs from: share/ holds the texts installed
into products, VERSION its version.
"""
from __future__ import annotations

import datetime
import difflib
import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import maelys_cli as cli  # noqa: E402

PROGRAM = "maelys-release"
PRODUCT = "Maelys Release"
Failure = cli.Failure
Invocation = cli.Invocation
EXIT_OK = cli.EXIT_OK
EXIT_FAILURE = cli.EXIT_FAILURE
EXIT_VIOLATIONS = cli.EXIT_VIOLATIONS

SOCLE_REPOSITORY = "maelys-dev/maelys-release"
DEFAULT_TAP = "maelys-dev/homebrew-tap"
DEFAULT_DOCUMENTS = "maelys-dev/maelys-docs"
DEFAULT_IMAGE = "ubuntu:26.04"
SOCLE_LINUX_PACKAGES = "build-essential dpkg-dev file rpm"  # the release.yml default
BOTTLES = '\'["macos-15","macos-26"]\''
PLATFORMS = {"linux-x86_64": "linux/amd64", "linux-arm64": "linux/arm64"}
# One name and one place for the reference a machine writes from describe
# (docs/policies/documentation.md of maelys-platform). Everything else in
# docs/ is prose, and prose lives in maelys-docs.
CLI_REFERENCE = "docs/cli.md"
CLI_CONTRACT = "docs/cli-contract.json"
# What a product declares about its own reference, when the conventions do
# not already say it: [programs] to describe, [flags] for the generator.
CLI_DECLARATIONS = "docs/cli.reference"
# maelys-cli carries the generator instead of pinning it: the framework is
# held to the same rule as the products it serves.
CLI_GENERATOR = "tools/generate_cli_reference.py"
LEGACY_CLI_REFERENCES = ("docs/cli-reference.md", "docs/generated/cli-reference.md")
# A generated file says so in its head, whatever wrote it: the word
# "generated" and a refusal to be edited, within the first ten lines. The
# generators live in maelys-cli and in the products, not here, so the socle
# fixes the rule rather than one spelling; the three in use satisfy it, and
# one of them sits on line 3, under the title.
GENERATED_HEAD_LINES = 10
GENERATED_MARK = re.compile(r"generated", re.IGNORECASE)
GENERATED_REFUSAL = re.compile(r"do not edit|don't edit|ne pas .diter", re.IGNORECASE)


def is_generated(text: str) -> bool:
    head = "\n".join(text.split("\n", GENERATED_HEAD_LINES)[:GENERATED_HEAD_LINES])
    return bool(GENERATED_MARK.search(head) and GENERATED_REFUSAL.search(head))
# What a product carries whatever publishes it, and what belongs to the
# socle's release mechanism. A product whose mechanism is custom or none
# receives and is checked on the first set only (docs/conventions.md,
# "Conventions and mechanism").
CONVENTION_MANAGED = ("AGENTS.md", "CLAUDE.md")
# Written once when missing, then owned by the product: the socle cannot
# judge prose it does not generate, so check reports absence as a note.
CONVENTION_SEEDED = ("RELEASING.md", "LICENSING.md", "SECURITY.md")
RELEASE_MANAGED = (
    ".github/workflows/release.yml",
    "scripts/checkout-dependency.sh",
    ".claude/skills/maelys-release/SKILL.md",
    ".github/workflows/ci.yml",
)
MANAGED = (
    ".github/workflows/release.yml",
    "scripts/checkout-dependency.sh",
    CLI_REFERENCE,
    CLI_CONTRACT,
    "AGENTS.md",
    "CLAUDE.md",
    ".claude/skills/maelys-release/SKILL.md",
    "RELEASING.md",
    "LICENSING.md",
    "SECURITY.md",
    ".github/workflows/ci.yml",
)
SOCLE_MECHANISM = "maelys-release"
MECHANISMS = (SOCLE_MECHANISM, "custom", "none")
RELEASE_USES = re.compile(rf"{re.escape(SOCLE_REPOSITORY)}/\.github/workflows/release\.yml@[0-9a-f]{{40}}")
CI_USES = re.compile(rf"({re.escape(SOCLE_REPOSITORY)}/\.github/workflows/check-product\.yml@)[0-9a-f]{{40}} # \S+")
BEGIN = "<!-- maelys-release:begin -->"
END = "<!-- maelys-release:end -->"


# ---- the socle itself --------------------------------------------------------

def socle_root() -> pathlib.Path:
    return pathlib.Path(__file__).resolve().parent.parent


def share_dir() -> pathlib.Path:
    root = socle_root()
    for candidate in (root / "share", root / "share" / "maelys-release"):
        if (candidate / "agents").is_dir():
            return candidate
    raise Failure("NOT_FOUND", f"share/agents not found under {root}.",
                  "Run from a maelys-release checkout or an installed prefix.")


def socle_version() -> str:
    for candidate in (socle_root() / "VERSION", share_dir() / "VERSION"):
        if candidate.is_file():
            version = candidate.read_text(encoding="utf-8").strip()
            if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", version):
                raise Failure("PRECONDITION_FAILED", f"The socle's VERSION is not X.Y.Z: {version!r}.",
                              "Fix VERSION of the socle; nothing generated from it can be trusted.")
            return version
    raise Failure("NOT_FOUND", "VERSION of the socle not found.", "Run from a maelys-release checkout.")


def run(command: list[str], cwd: pathlib.Path | None = None, env: dict[str, str] | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(command, cwd=cwd, env=env, check=False, text=True,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def git(*arguments: str, cwd: pathlib.Path | None = None, check: bool = True) -> str:
    completed = run(["git", *arguments], cwd=cwd)
    if check and completed.returncode != 0:
        raise Failure("PROCESS_FAILED", f"git {' '.join(arguments)} failed: {completed.stderr.strip()}",
                      "Fix the repository state and retry.")
    return completed.stdout.strip() if completed.returncode == 0 else ""


def socle_identity(sha: str, tag: str) -> tuple[str, str]:
    """The commit and tag written into the managed files.

    The files a product receives must be exactly what the pinned socle
    regenerates, so a checkout with uncommitted changes to what adopt
    writes (share/, bin/) is refused: its output would name a commit that
    does not produce it.
    """
    if sha:
        return sha, tag or "untagged"
    root = socle_root()
    if not (root / ".git").exists():
        version = socle_version()
        raise Failure("PRECONDITION_FAILED", "This socle is not a git checkout (an archive of a tag, or an installed"
                      " copy), so its commit is unknown, and the pin must name the commit.",
                      f"Pass the commit of the tag: --socle-sha \"$(git ls-remote https://github.com/{SOCLE_REPOSITORY}.git"
                      f" 'v{version}^{{}}' | cut -f1)\" --socle-tag v{version}; or run from a checkout at that tag.")
    dirty = git("status", "--porcelain", "--", "share", "bin", "VERSION", cwd=root, check=False)
    if dirty:
        raise Failure("PRECONDITION_FAILED", "This socle checkout has uncommitted changes in share/, bin/ or VERSION;"
                      " what it would write names a commit that does not produce it.",
                      "Commit or stash the socle's changes, or run the socle at a tag.")
    return git("rev-parse", "HEAD", cwd=root), git("describe", "--tags", "--exact-match", cwd=root, check=False) or "untagged"


# ---- the product contract ----------------------------------------------------

class Declarations:
    """What a product declares, read once and used by every command."""

    def __init__(self, project: pathlib.Path, product: str, mechanism: str = SOCLE_MECHANISM) -> None:
        self.project = project
        self.product = product
        # How this product publishes: the socle's workflows, a mechanism of
        # its own, or nothing. It decides which files adopt writes and which
        # checks apply; the conventions apply to all three.
        self.mechanism = mechanism
        self.version = ""
        self.formulas: list[str] = []
        self.render_command = ""
        self.dependencies: list[str] = []
        self.linux_packages = ""
        self.macos_packages = ""
        self.generates_reference = False
        self.cli_programs: list[str] = []
        self.cli_flags: list[str] = []
        self.cli_build = ""
        self.verify_command = ""
        # name -> repository, for a dependency that does not live in maelys-dev
        self.foreign: dict[str, str] = {}
        # Files of docs/ that are neither generated, engaged by LICENSING.md
        # nor data: they belong in maelys-docs/<product>/.
        self.prose: list[str] = []
        self.checks: list[dict] = []

    @property
    def releases_here(self) -> bool:
        """Whether the socle's release mechanism applies to this product."""
        return self.mechanism == SOCLE_MECHANISM

    def applicable(self) -> list[dict]:
        """The checks that hold for this product: its mechanism's, and the conventions."""
        return [check for check in self.checks
                if check["scope"] == "conventions" or self.releases_here]

    @property
    def valid(self) -> bool:
        """Whether adopt may proceed; a warning is reported by check only."""
        return all(check["status"] in ("ok", "note", "warn") for check in self.applicable())

    def add(self, status: str, message: str, scope: str = "release") -> None:
        self.checks.append({"status": status, "message": message, "scope": scope})


def parse_packages(text: str) -> tuple[str, str]:
    """dependencies/packages: one package per line under [linux] or [macos]."""
    packages: dict[str, list[str]] = {"linux": [], "macos": []}
    section = ""
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("["):
            if line in ("[linux]", "[macos]"):
                section = line[1:-1]
                continue
            raise ValueError(f"unknown section {line} at line {number}")
        if not section:
            raise ValueError(f"package outside a [linux] or [macos] section at line {number}")
        if len(line.split()) != 1 or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9+._@:-]*", line):
            raise ValueError(f"one package per line at line {number}: {raw}")
        packages[section].append(line)
    return " ".join(packages["linux"]), " ".join(packages["macos"])


def read_declarations(project: pathlib.Path, product: str, mechanism: str = SOCLE_MECHANISM) -> Declarations:
    decl = Declarations(project, product, mechanism)
    version_file = project / "VERSION"
    if not version_file.is_file():
        decl.add("missing", "VERSION file", "conventions")
    else:
        text = version_file.read_text(encoding="utf-8").strip()
        if re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", text):
            decl.version = text
            decl.add("ok", "VERSION file", "conventions")
        else:
            decl.add("missing", "VERSION must be X.Y.Z", "conventions")
    packager = project / "scripts" / "package-release.sh"
    decl.add("ok" if packager.is_file() and os.access(packager, os.X_OK) else "missing",
             "scripts/package-release.sh TARGET writing dist/")
    changelog = project / "CHANGELOG.md"
    if not changelog.is_file():
        decl.add("missing", "CHANGELOG.md", "conventions")
    else:
        decl.add("ok", "CHANGELOG.md", "conventions")
        # The release of VERSION needs its dated entry; the workflow only
        # compares VERSION with the tag, so the entry is checked here.
        if decl.version:
            pattern = rf"^## {re.escape(decl.version)}\s.*[0-9]{{4}}-[0-9]{{2}}-[0-9]{{2}}"
            if re.search(pattern, changelog.read_text(encoding="utf-8"), re.MULTILINE):
                decl.add("ok", f"CHANGELOG.md has a dated ## {decl.version} entry", "conventions")
            else:
                decl.add("missing", f"CHANGELOG.md needs a dated entry: ## {decl.version} — YYYY-MM-DD", "conventions")
    # Every packaging/homebrew/NAME.rb.in becomes one tap job publishing NAME:
    # a formula is named after what it installs, not after the repository.
    homebrew = project / "packaging" / "homebrew"
    decl.formulas = sorted(path.name[: -len(".rb.in")] for path in homebrew.glob("*.rb.in")) if homebrew.is_dir() else []
    if decl.formulas:
        decl.add("ok", "Homebrew formula templates: " + " ".join(decl.formulas))
    else:
        decl.add("note", "no packaging/homebrew/*.rb.in: no tap job")
    verifier = project / "scripts" / "verify-release.sh"
    if verifier.is_file() and os.access(verifier, os.X_OK):
        decl.verify_command = "sh scripts/verify-release.sh TARGET"
        decl.add("ok", "scripts/verify-release.sh TARGET runs before packaging at the tag")
    renderer = project / "scripts" / "render-homebrew-formula.sh"
    if renderer.is_file() and os.access(renderer, os.X_OK):
        decl.render_command = "sh scripts/render-homebrew-formula.sh TAG OUTPUT"
        decl.add("ok", "scripts/render-homebrew-formula.sh renders the formula")
    # Dependencies: one dependencies/NAME.pin per Maelys repository, nearest
    # tag on line 1 for humans and the pinned commit on line 2. The managed
    # scripts/checkout-dependency.sh clones each of them from the pin.
    dependencies = project / "dependencies"
    for pin in sorted(dependencies.glob("*.pin")) if dependencies.is_dir() else []:
        name = pin.name[: -len(".pin")]
        lines = pin.read_text(encoding="utf-8").splitlines()
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", name):
            decl.add("missing", f"dependencies/{pin.name}: the file is named after the repository, [a-z0-9-]",
                     "conventions")
        elif len(lines) >= 2 and re.fullmatch(r"[0-9a-f]{40}", lines[1].strip()):
            decl.dependencies.append(name)
            # A dependency outside maelys-dev says where it lives, once, in
            # its own pin: maelys-http builds Mbed TLS from a pinned commit
            # because the distribution's version is under its security floor.
            for attribute in lines[2:]:
                if not attribute.startswith("repository "):
                    continue
                repository = attribute[len("repository "):].strip()
                if not re.fullmatch(r"https://[^\s]+", repository):
                    decl.add("missing", f"dependencies/{pin.name}: the repository line must be an https URL", "conventions")
                else:
                    decl.foreign[name] = repository
        else:
            decl.add("missing", f"dependencies/{pin.name}: line 2 must be the pinned commit (line 1 its tag)",
                     "conventions")
    if (project / "adapter").is_dir():
        decl.add("refused", "adapter/ is the pre-0.14 layout: git mv adapter/<NAME>_PIN dependencies/<name>.pin"
                 " and adapter/PACKAGES dependencies/packages, then delete adapter/ and the Makefile lines that read it")
    if decl.dependencies:
        decl.add("ok", "pinned dependencies: " + " ".join(decl.dependencies), "conventions")
    for name, repository in sorted(decl.foreign.items()):
        decl.add("ok", f"dependencies/{name}.pin is cloned from {repository}, not maelys-dev", "conventions")
    scripts = project / "scripts"
    stray = sorted(path.name for path in scripts.glob("checkout-*.sh")
                   if path.name != "checkout-dependency.sh") if scripts.is_dir() else []
    if stray:
        decl.add("refused", "scripts/" + " scripts/".join(stray)
                 + ": dependencies are cloned from dependencies/*.pin by the managed"
                 " scripts/checkout-dependency.sh NAME; delete these")
    ci = project / ".github" / "workflows" / "ci.yml"
    if ci.is_file():
        if CI_USES.search(ci.read_text(encoding="utf-8")):
            decl.add("ok", ".github/workflows/ci.yml calls check-product.yml of the socle")
        else:
            decl.add("warn", ".github/workflows/ci.yml does not call the socle's check-product.yml: add a job"
                     f" 'uses: {SOCLE_REPOSITORY}/.github/workflows/check-product.yml@SHA # TAG'"
                     f" with 'product: {product}', as adopt would create it")
    read_docs(decl)
    packages = dependencies / "packages"
    if packages.is_file():
        try:
            decl.linux_packages, decl.macos_packages = parse_packages(packages.read_text(encoding="utf-8"))
            decl.add("ok", f"dependencies/packages: linux [{decl.linux_packages}] macos [{decl.macos_packages}]",
                     "conventions")
        except ValueError as error:
            decl.add("missing", f"dependencies/packages: {error}", "conventions")
    return decl


def declared_mechanism(project: pathlib.Path, requested: str = "") -> str:
    """How the product publishes, read from the release.yml it carries.

    A repository declares its mechanism by the workflow it holds: the socle's
    generated release.yml names the socle, a workflow of its own does not,
    and no release.yml at all means the socle does not release it. The last
    case is not an invitation: maelys-warden publishes through its own
    qualify and publish workflows and carries no release.yml, and writing one
    into it uninvited would be the socle claiming a repository that never
    asked. Installing the socle's mechanism is therefore explicit,
    --mechanism maelys-release, which is what new passes.
    """
    workflow = project / ".github" / "workflows" / "release.yml"
    if not workflow.is_file():
        return requested or "custom"
    carried = SOCLE_MECHANISM if RELEASE_USES.search(workflow.read_text(encoding="utf-8")) else "custom"
    # custom and none both say "the socle does not release this"; which of the
    # two is a refinement the repository may state. Only crossing that line is
    # a contradiction: it would either abandon a generated workflow or
    # overwrite one the socle never wrote.
    if requested and requested != carried and SOCLE_MECHANISM in (requested, carried):
        raise Failure("PRECONDITION_FAILED",
                      f"{project} carries a {carried} release.yml, so --mechanism {requested} contradicts it.",
                      "Delete or move .github/workflows/release.yml to change the mechanism of a repository;"
                      " the socle never overwrites a workflow it did not generate.")
    return requested or carried


def engaged_documents(project: pathlib.Path) -> set[str]:
    """The docs/ files LICENSING.md links: a public engagement stays here."""
    licensing = project / "LICENSING.md"
    if not licensing.is_file():
        return set()
    return {match.replace("./", "") for match in
            re.findall(r"\(([^)\s]*docs/[^)\s#]+)\)", licensing.read_text(encoding="utf-8"))}


def parse_cli_declarations(text: str) -> tuple[list[str], list[str], str]:
    """docs/cli.reference: [build] holding the programs, [programs], [flags]."""
    sections: dict[str, list[str]] = {"build": [], "programs": [], "flags": []}
    section = ""
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("["):
            if line[1:-1] not in sections or not line.endswith("]"):
                raise ValueError(f"unknown section {line} at line {number}")
            section = line[1:-1]
            continue
        if not section:
            raise ValueError(f"line outside a [programs] or [flags] section at line {number}")
        if section == "programs":
            if not re.fullmatch(r"[a-z0-9][a-z0-9._-]*", line):
                raise ValueError(f"one program per line at line {number}: {raw}")
            sections["programs"].append(line)
        elif section == "build":
            if sections["build"]:
                raise ValueError(f"[build] holds one directory, a second at line {number}")
            if line.startswith("/") or ".." in pathlib.PurePosixPath(line).parts:
                raise ValueError(f"[build] is a path inside the product at line {number}: {raw}")
            sections["build"].append(line)
        else:
            sections["flags"].extend(line.split())
    return sections["programs"], sections["flags"], (sections["build"][0] if sections["build"] else "")


def read_docs(decl: Declarations) -> None:
    """Classify docs/: the generated reference, public engagements, data, prose.

    The rule is maelys-platform's documentation policy: a product repository
    keeps what a machine writes and what LICENSING.md engages; its prose
    lives in maelys-docs/<product>/. The socle names what must move, and
    moves nothing.
    """
    docs = decl.project / "docs"
    reference = decl.project / CLI_REFERENCE
    # A product whose command line is built on the framework pins maelys-cli,
    # whose generator writes the reference. The socle owns the wrapper, so the
    # reference is produced the same way everywhere; the product's Makefile
    # calls it and overrides by environment what its layout requires.
    has_generator = "maelys-cli" in decl.dependencies or (decl.project / CLI_GENERATOR).is_file()
    commands = [name for name in decl.formulas if not name.startswith("lib")]
    declarations = decl.project / CLI_DECLARATIONS
    if declarations.is_file():
        try:
            decl.cli_programs, decl.cli_flags, decl.cli_build = \
                parse_cli_declarations(declarations.read_text(encoding="utf-8"))
        except ValueError as error:
            decl.add("missing", f"{CLI_DECLARATIONS}: {error}", "conventions")
    # A product whose command line is built on the framework pins maelys-cli,
    # whose generator writes the reference. The socle runs it: no product
    # carries a rule, a path or a drift check of its own for this.
    if has_generator and reference.is_file():
        if not decl.cli_programs:
            decl.cli_programs = commands or [decl.product]
        decl.generates_reference = True
        decl.add("ok", f"{CLI_REFERENCE} is generated by the socle from maelys-cli's generator:"
                 f" {' '.join(decl.cli_programs)}", "conventions")
    legacy = [name for name in LEGACY_CLI_REFERENCES if (decl.project / name).is_file()]
    for name in legacy:
        decl.add("note", f"{name}: the generated CLI reference is {CLI_REFERENCE} for every product;"
                 f" git mv {name} {CLI_REFERENCE} and point the rule that writes it there", "conventions")
    if not docs.is_dir():
        return
    if reference.is_file():
        if is_generated(reference.read_text(encoding="utf-8")):
            decl.add("ok", f"{CLI_REFERENCE} is generated", "conventions")
        else:
            decl.add("warn", f"{CLI_REFERENCE} does not say in its first {GENERATED_HEAD_LINES} lines that it is"
                     " generated and must not be edited; the reference is written from describe, never by hand",
                     "conventions")
    elif not legacy and not has_generator and commands:
        # Only a product that ships a command can carry a reference: a library
        # publishes lib* alone and is told nothing about docs/cli.md.
        decl.add("note", f"no {CLI_REFERENCE}: a product with a command line carries its generated reference there",
                 "conventions")
    engaged = engaged_documents(decl.project)
    for path in sorted(docs.rglob("*")):
        if not path.is_file():
            continue
        relative = path.relative_to(decl.project).as_posix()
        if relative == CLI_REFERENCE or relative in legacy or relative in engaged:
            continue
        if path.suffix.lower() != ".md":
            continue  # data, never prose
        if is_generated(path.read_text(encoding="utf-8")):
            continue
        decl.prose.append(relative)
    for relative in decl.prose:
        decl.add("note", f"{relative}: prose belongs in maelys-docs/{decl.product}/"
                 f"{relative[len('docs/'):]}; move it with its history:"
                 f" 'maelys-platform docs --prose --only {decl.product} --format jsonl"
                 f" | {PROGRAM} migrate . --product {decl.product} --documents -'", "conventions")


def pinned_product(project: pathlib.Path) -> str:
    """The product name the existing release.yml carries, or ''."""
    workflow = project / ".github" / "workflows" / "release.yml"
    if not workflow.is_file():
        return ""
    match = re.search(r"^\s+product:\s+(\S+)\s*$", workflow.read_text(encoding="utf-8"), re.MULTILINE)
    return match.group(1) if match else ""


def project_of(invocation: Invocation) -> tuple[pathlib.Path, str, str]:
    directory = pathlib.Path(invocation.operands[0])
    if not directory.is_dir():
        raise Failure("NOT_FOUND", f"DIR is not a directory: {directory}.", "Pass the product repository.")
    project = directory.resolve()
    # The product name comes from --product, else from the release.yml the
    # product already carries, else from the directory: a worktree or a
    # scratch clone is rarely named after the product it holds.
    product = invocation.option("--product") or pinned_product(project) or project.name
    if not re.fullmatch(r"[a-z0-9-]+", product):
        raise Failure("VALIDATION_FAILED", f"Product name must be [a-z0-9-]: {product}.",
                      "Pass --product NAME with a valid name.")
    return project, product, declared_mechanism(project, str(invocation.option("--mechanism", "")))


def require_valid(decl: Declarations, action: str) -> None:
    if not decl.valid:
        problems = [check["message"] for check in decl.applicable() if check["status"] not in ("ok", "note")]
        raise Failure("PRECONDITION_FAILED", f"{decl.project} does not meet the product contract, so {action} is refused: "
                      + "; ".join(problems) + ".", f"Run '{PROGRAM} check {decl.project}' and fix every violation.")


def require_socle_mechanism(project: pathlib.Path, mechanism: str, action: str) -> None:
    """rehearse and preflight replay the socle's release; nothing else does."""
    if mechanism != SOCLE_MECHANISM:
        raise Failure("PRECONDITION_FAILED",
                      f"{project} publishes through a {mechanism} mechanism, so {action} does not apply to it.",
                      f"'{PROGRAM} check {project}' verifies the conventions of a product the socle does not release.")


# ---- the managed files -------------------------------------------------------

def render_text(template: pathlib.Path, mapping: dict[str, str]) -> str:
    text = template.read_text(encoding="utf-8")
    for key, value in mapping.items():
        text = text.replace(f"@{key}@", value)
    return text


def release_workflow(decl: Declarations, sha: str, tag: str, version: str) -> str:
    lines = [
        "name: release",
        "",
        f"# Managed by maelys-release {tag} ({version}). Regenerate with",
        f"# '{PROGRAM} adopt' of maelys-release; do not edit by hand.",
        # A job that calls a reusable workflow cannot be granted more than the
        # caller workflow declares at the top level, so the ceiling is set
        # here and each job narrows it.
        "on:",
        "  push:",
        '    tags: ["v*"]',
        "  workflow_dispatch:",
        "    inputs:",
        "      tag:",
        "        description: Existing signed tag whose release and Homebrew publication are replayed",
        "        required: true",
        "        type: string",
        "",
        "permissions:",
        "  contents: write",
        "  id-token: write",
        "  attestations: write",
        "",
        "jobs:",
        "  release:",
        f"    uses: {SOCLE_REPOSITORY}/.github/workflows/release.yml@{sha} # {tag}",
        "    permissions:",
        "      contents: write",
        "      id-token: write",
        "      attestations: write",
        "    with:",
        f"      product: {decl.product}",
        "      tag: ${{ inputs.tag || github.ref_name }}",
    ]
    if decl.dependencies:
        lines.append("      dependency_checkout: |")
        lines.extend(f"        sh scripts/checkout-dependency.sh {name}" for name in decl.dependencies)
    if decl.verify_command:
        lines.append(f"      verify_command: {decl.verify_command}")
    if decl.linux_packages:
        lines.append(f"      linux_packages: {SOCLE_LINUX_PACKAGES} {decl.linux_packages}")
    if decl.macos_packages:
        lines.append(f"      macos_packages: {decl.macos_packages}")
    for formula in decl.formulas:
        lines.extend([
            "",
            f"  tap-{formula}:",
            "    needs: release",
            "    if: needs.release.result == 'success'",
            f"    uses: {SOCLE_REPOSITORY}/.github/workflows/tap.yml@{sha} # {tag}",
            "    permissions:",
            "      contents: write",
            "      id-token: write",
            "      attestations: write",
            "    with:",
            f"      product: {formula}",
            "      tag: ${{ inputs.tag || github.ref_name }}",
        ])
        if decl.render_command:
            lines.append(f"      render_command: {decl.render_command} {formula}")
        lines.extend([
            f"      bottles: {BOTTLES}",
            "    secrets:",
            "      tap_token: ${{ secrets.HOMEBREW_TAP_TOKEN }}",
            "      tap_signing_key: ${{ secrets.HOMEBREW_TAP_SIGNING_KEY }}",
        ])
    return "\n".join(lines) + "\n"


def ci_workflow(decl: Declarations, sha: str, tag: str, version: str) -> str:
    """Created once from the same declarations, then owned by the product."""
    lines = [
        "name: ci",
        "",
        f"# Created by maelys-release {tag} ({version}) and owned by this repository: add",
        "# jobs next to check; adopt keeps the socle line of check current.",
        "on:",
        "  push:",
        "    branches: [main]",
        "  pull_request:",
        "",
        "permissions:",
        "  contents: read",
        "",
        "jobs:",
        "  check:",
        f"    uses: {SOCLE_REPOSITORY}/.github/workflows/check-product.yml@{sha} # {tag}",
        "    with:",
        f"      product: {decl.product}",
    ]
    return "\n".join(lines) + "\n"


def managed_block(existing: str | None, block: str) -> str:
    """Replace the block between the markers, or append it."""
    if existing is not None and BEGIN in existing:
        out: list[str] = []
        skipping = False
        for line in existing.splitlines():
            if line.strip() == BEGIN:
                out.extend([BEGIN, *block.rstrip("\n").splitlines(), END])
                skipping = True
            elif line.strip() == END:
                skipping = False
            elif not skipping:
                out.append(line)
        return "\n".join(out) + "\n"
    head = (existing.rstrip("\n") + "\n\n") if existing else ""
    return head + BEGIN + "\n" + block.rstrip("\n") + "\n" + END + "\n"


def stage(decl: Declarations, sha: str, tag: str) -> dict[str, tuple[str, bool]]:
    """Every managed file as (content, executable), rendered for the product.

    A product the socle does not release receives the conventions alone: its
    workflows are its own, and nothing here touches them.
    """
    version = socle_version()
    share = share_dir()
    formulas = ", ".join(f"packaging/homebrew/{name}.rb.in" for name in decl.formulas) \
        or "packaging/homebrew/<name>.rb.in"
    mapping = {"PRODUCT": decl.product, "FORMULAS": formulas, "SOCLE_TAG": tag, "SOCLE_VERSION": version}
    staged: dict[str, tuple[str, bool]] = {}
    if decl.releases_here:
        staged[".github/workflows/release.yml"] = (release_workflow(decl, sha, tag, version), False)
        staged[".claude/skills/maelys-release/SKILL.md"] = (
            render_text(share / "agents" / "claude-skill.md", mapping), False)
        if decl.dependencies:
            staged["scripts/checkout-dependency.sh"] = (
                render_text(share / "templates" / "checkout-dependency.sh", mapping), True)
    # The managed block states the rules that hold here: the socle's release
    # mechanism for a product it releases, the conventions alone otherwise.
    block_source = "instructions-block.md" if decl.releases_here else "conventions-block.md"
    block = render_text(share / "agents" / block_source, mapping)
    for name in CONVENTION_MANAGED:
        path = decl.project / name
        existing = path.read_text(encoding="utf-8") if path.is_file() else None
        staged[name] = (managed_block(existing, block), False)
    if decl.generates_reference:
        reference, contract = render_cli_reference(decl)
        staged[CLI_REFERENCE] = (reference, False)
        staged[CLI_CONTRACT] = (contract, False)
    releasing = "RELEASING.md" if decl.releases_here else "RELEASING-conventions.md"
    for name, template in (("RELEASING.md", releasing), ("LICENSING.md", "LICENSING.md"),
                           ("SECURITY.md", "SECURITY.md")):
        if not (decl.project / name).is_file():
            staged[name] = (render_text(share / "templates" / template, mapping), False)
    # The shared CI is not the release mechanism: a product that publishes
    # by itself can still run check-product.yml, which finds the socle from
    # the ci.yml line that calls it. A repository that publishes by nothing
    # at all keeps its workflows to itself.
    if decl.mechanism == "none":
        return staged
    ci = decl.project / ".github" / "workflows" / "ci.yml"
    if not ci.is_file():
        staged[".github/workflows/ci.yml"] = (ci_workflow(decl, sha, tag, version), False)
    else:
        # The product owns its ci.yml; only the line naming the socle is managed.
        existing = ci.read_text(encoding="utf-8")
        if CI_USES.search(existing):
            staged[".github/workflows/ci.yml"] = (CI_USES.sub(rf"\g<1>{sha} # {tag}", existing), False)
    return staged


def cli_generator(decl: Declarations) -> pathlib.Path | None:
    """maelys-cli's reference generator, at the commit the product pins.

    The product declares maelys-cli once, in dependencies/maelys-cli.pin; the
    socle fetches that commit into its own cache. A checkout beside the
    product at the same commit is used as it stands, which keeps this offline
    and matches what scripts/checkout-dependency.sh leaves there.
    """
    # The framework holds the generator; every other product pins it.
    own = decl.project / CLI_GENERATOR
    if own.is_file():
        return own
    pin = decl.project / "dependencies" / "maelys-cli.pin"
    if not pin.is_file():
        return None
    sha = pin.read_text(encoding="utf-8").splitlines()[1].strip()
    relative = pathlib.Path(CLI_GENERATOR)
    sibling = decl.project.parent / "maelys-cli"
    if (sibling / relative).is_file():
        head = run(["git", "-C", str(sibling), "rev-parse", "HEAD"]).stdout.strip()
        if head == sha:
            return sibling / relative
    checkout = pinned_checkout("maelys-cli", sha, str(relative))
    return checkout / relative if checkout and (checkout / relative).is_file() else None


def render_cli_reference(decl: Declarations) -> tuple[str, str]:
    """The reference and its contract, generated as maelys-cli generates them.

    The socle runs the generator itself, so no product carries a rule, a path
    or a drift check of its own for this. What cannot be produced here (an
    unbuilt product, an unreachable maelys-cli) leaves both files as they
    stand rather than reporting a drift the socle cannot substantiate.
    """
    def existing() -> tuple[str, str]:
        return tuple((decl.project / name).read_text(encoding="utf-8")
                     if (decl.project / name).is_file() else ""
                     for name in (CLI_REFERENCE, CLI_CONTRACT))  # type: ignore[return-value]

    generator = cli_generator(decl)
    if generator is None:
        decl.add("note", f"{CLI_REFERENCE}: maelys-cli is not available at the pinned commit;"
                 " the reference is left as it stands", "conventions")
        return existing()
    # Three products, three build layouts (build/release, build/<profile>,
    # a platform tree): the directory holding the programs is declared, not
    # guessed, with the commonest as the default.
    build = decl.project / os.environ.get("CLI_REFERENCE_BUILD", decl.cli_build or "build/bin")
    with tempfile.TemporaryDirectory(prefix="maelys-release-cli-reference.") as temp:
        markdown = pathlib.Path(temp) / "cli.md"
        contract = pathlib.Path(temp) / "cli-contract.json"
        completed = run([sys.executable, str(generator), "--build", str(build),
                         "--markdown", str(markdown), "--json", str(contract),
                         *decl.cli_flags, *decl.cli_programs], cwd=decl.project)
        if completed.returncode != 0 or not markdown.is_file():
            decl.add("note", f"{CLI_REFERENCE}: the generator did not run here"
                     " (an unbuilt product, usually); the reference is left as it stands", "conventions")
            return existing()
        return markdown.read_text(encoding="utf-8"), contract.read_text(encoding="utf-8")


def plan(decl: Declarations, staged: dict[str, tuple[str, bool]], apply: bool) -> list[dict]:
    """One entry per managed file: create, update or same; written when applying."""
    files: list[dict] = []
    for relative in MANAGED:
        if relative not in staged:
            continue
        content, executable = staged[relative]
        path = decl.project / relative
        entry: dict = {"path": relative,
                       "scope": "conventions" if relative in CONVENTION_MANAGED + CONVENTION_SEEDED
                       + (CLI_REFERENCE, CLI_CONTRACT, ".github/workflows/ci.yml")
                       else "release"}
        if relative in CONVENTION_SEEDED:
            entry["seeded"] = True
        if not path.is_file():
            entry["action"] = "create"
        else:
            current = path.read_text(encoding="utf-8")
            if current != content:
                entry["action"] = "update"
                entry["diff"] = "".join(difflib.unified_diff(
                    current.splitlines(keepends=True), content.splitlines(keepends=True), relative, relative))
            elif executable and not os.access(path, os.X_OK):
                entry["action"] = "update"
                entry["reason"] = "not executable"
            else:
                entry["action"] = "same"
        if apply and entry["action"] != "same":
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content, encoding="utf-8")
            if executable:
                path.chmod(path.stat().st_mode | 0o111)
        files.append(entry)
    return files


def pinned_socle(project: pathlib.Path) -> dict | None:
    """The socle sha and tag the product pins, from release.yml or from ci.yml.

    A product the socle releases names it in release.yml. A product that
    keeps its own release names it in the ci.yml line that calls
    check-product.yml, and nowhere else: reading release.yml alone left that
    product with no pin at all, so the tag of a socle fetched by commit
    stayed "untagged" and the regenerated ci.yml drifted against its own
    committed line.
    """
    workflows = project / ".github" / "workflows"
    for name, workflow in (("release.yml", "release"), ("ci.yml", "check-product")):
        path = workflows / name
        if not path.is_file():
            continue
        match = re.search(rf"{re.escape(SOCLE_REPOSITORY)}/\.github/workflows/{workflow}\.yml@([0-9a-f]{{40}}) # (\S+)",
                          path.read_text(encoding="utf-8"))
        if match:
            return {"sha": match.group(1), "tag": match.group(2)}
    return None


def socle_data(sha: str, tag: str) -> dict:
    return {"version": socle_version(), "tag": tag, "sha": sha}


def pinned_checkout(name: str, sha: str, witness: str) -> pathlib.Path | None:
    """A checkout of `name` at `sha`, fetched once into the user's cache.

    `witness` is the file whose presence means the cache already holds this
    commit. None when the fetch fails, so a caller can degrade instead of
    failing; a checkout that lacks the witness is still returned, because
    "fetched but old" and "not fetched" are different answers.
    """
    root = pathlib.Path(os.environ.get("XDG_CACHE_HOME") or pathlib.Path.home() / ".cache") / "maelys-release"
    cache = root / sha if name == "maelys-release" else root / f"{name}-{sha}"
    if (cache / witness).is_file():
        return cache
    base = os.environ.get("MAELYS_GIT_BASE", "https://github.com/maelys-dev")
    cache.parent.mkdir(parents=True, exist_ok=True)
    git("init", "-q", str(cache))
    fetched = run(["git", "fetch", "-q", "--depth", "1", f"{base}/{name}.git", sha], cwd=cache)
    if fetched.returncode != 0:
        return None
    git("checkout", "-q", "FETCH_HEAD", cwd=cache)
    return cache


def pinned_socle_checkout(sha: str) -> pathlib.Path:
    """A checkout of the socle at `sha`; the relocation cannot degrade."""
    cache = pinned_checkout("maelys-release", sha, "bin/maelys-release")
    if cache is None:
        raise Failure("NOT_FOUND", f"maelys-release {sha[:7]} could not be fetched.",
                      "Check the network, or run with MAELYS_RELEASE_NO_RELOCATE=1.")
    if (cache / "bin" / "maelys-release").is_file():
        (cache / "bin" / "maelys-release").chmod(0o755)
    return cache


def run_pinned_socle(invocation: Invocation, project: pathlib.Path) -> None:
    """Hand the invocation to the socle the product pins, when this is another one.

    A product's CI fetches the pinned socle itself; a developer's sibling
    checkout drifts as soon as anyone moves it. check, preflight and
    rehearse therefore re-execute themselves from a cached checkout at the
    pinned commit, so the answer is always the pinned socle's. adopt does
    not: moving the pin is exactly its purpose. MAELYS_RELEASE_NO_RELOCATE=1
    keeps the running socle, and --socle-sha names one explicitly.
    """
    if invocation.option("--socle-sha") or os.environ.get("MAELYS_RELEASE_NO_RELOCATE") == "1":
        return
    pinned = pinned_socle(project)
    if not pinned:
        return
    root = socle_root()
    if (root / ".git").exists() and git("rev-parse", "HEAD", cwd=root, check=False) == pinned["sha"]:
        return
    try:
        checkout = pinned_socle_checkout(pinned["sha"])
    except Failure as failure:
        raise Failure("PRECONDITION_FAILED",
                      f"{project.name} pins maelys-release {pinned['tag']} ({pinned['sha'][:7]}) but this is another"
                      f" socle, and the pinned one could not be fetched: {failure.message}",
                      "Check out the pinned tag, or set MAELYS_RELEASE_NO_RELOCATE=1 to run this socle anyway.") from failure
    if not (checkout / "bin" / "maelys-release").is_file():
        # before 0.5.0 the socle was scripts/adopt.sh: it cannot answer for itself
        raise Failure("PRECONDITION_FAILED",
                      f"{pinned_product(project) or project.name} pins maelys-release {pinned['tag']} ({pinned['sha'][:7]}), which predates the"
                      " maelys-release command (0.5.0) and cannot answer for itself.",
                      f"Upgrade it from a current socle at a tag: 'adopt {project} --apply', then check.")
    if invocation.format == "text":
        print(f"note     running the pinned socle {pinned['tag']} ({pinned['sha'][:7]}) from {checkout}", file=sys.stderr)
        sys.stderr.flush()
    sys.stdout.flush()
    environment = {**os.environ, "MAELYS_RELEASE_NO_RELOCATE": "1"}
    os.execve(str(checkout / "bin" / "maelys-release"), [PROGRAM, *sys.argv[1:]], environment)


# ---- handlers: each returns (data, exit code) ---------------------------------

def resolve_dependency(spec: str) -> tuple[str, str, str]:
    """`name@vX.Y.Z` to (name, tag, commit), the tag resolved on the remote."""
    name, separator, tag = spec.partition("@")
    if not separator or not re.fullmatch(r"[a-z0-9][a-z0-9-]*", name) or not re.fullmatch(r"v[0-9]+\.[0-9]+\.[0-9]+", tag):
        raise Failure("VALIDATION_FAILED", f"A dependency is NAME@vX.Y.Z, not {spec!r}.",
                      "Pass --depends maelys-system@v0.9.1, once per dependency.")
    base = os.environ.get("MAELYS_GIT_BASE", "https://github.com/maelys-dev")
    # The dereferenced tag (^{}) is the commit an annotated tag names, which
    # is what a pin holds; a lightweight tag answers on the first line.
    listed = run(["git", "ls-remote", "--tags", f"{base}/{name}.git", tag, f"{tag}^{{}}"])
    if listed.returncode != 0:
        raise Failure("NOT_FOUND", f"{base}/{name}.git could not be read for {tag}.",
                      "Check the dependency name and that the remote is reachable.")
    commits = {line.split("\t")[1]: line.split("\t")[0] for line in listed.stdout.splitlines() if "\t" in line}
    commit = commits.get(f"refs/tags/{tag}^{{}}") or commits.get(f"refs/tags/{tag}")
    if not commit:
        raise Failure("NOT_FOUND", f"{name} has no tag {tag}.", f"Pick a tag that {base}/{name} publishes.")
    return name, tag, commit


def scaffold(project: pathlib.Path, product: str, dependencies: list[tuple[str, str, str]]) -> dict[str, str]:
    """The files a repository carries before the socle writes anything into it."""
    today = datetime.date.today().isoformat()
    license_text = (socle_root() / "LICENSE").read_text(encoding="utf-8")
    if "Mozilla Public License" not in license_text.split("\n", 1)[0]:
        raise Failure("PRECONDITION_FAILED", "The socle's LICENSE is not the MPL-2.0 text it copies.",
                      "Run this from a maelys-release checkout.")
    files = {
        "LICENSE": license_text,
        "VERSION": "0.1.0\n",
        "CHANGELOG.md": f"# Changelog\n\n## 0.1.0 — {today}\n\n- First release of {product}.\n",
        "README.md": f"# {product}\n\n*One paragraph: what this repository is, and what it is not.*\n\n"
                     f"## Install\n\n*How a user gets it.*\n\n## Build\n\n```sh\nmake check\n```\n",
        # A release must not silently publish nothing: the stub fails until
        # the product says how it packages.
        "scripts/package-release.sh":
            "#!/bin/sh\n# Package $1 (linux-x86_64, linux-arm64, macos-arm64) into dist/,\n"
            "# with one .sha256 next to each artifact. Written by maelys-release new.\n"
            "set -eu\n"
            'echo "scripts/package-release.sh: $1 is not implemented yet" >&2\n'
            "exit 1\n",
    }
    for name, tag, commit in dependencies:
        files[f"dependencies/{name}.pin"] = f"{tag}\n{commit}\n"
    del project
    return files


def read_prose_records(source: str) -> list[dict]:
    """The documents to move, as maelys-platform lists them.

    One JSON record per line, `docs --prose --only PRODUCT --format jsonl`:
    the classification lives there and is not recomputed here, so the socle
    and the platform cannot disagree about what is prose.
    """
    stream = sys.stdin.read() if source == "-" else pathlib.Path(source).read_text(encoding="utf-8")
    records = []
    for number, line in enumerate(stream.splitlines(), 1):
        line = line.strip()
        if not line:
            continue
        try:
            record = json.loads(line)
        except json.JSONDecodeError as error:
            raise Failure("VALIDATION_FAILED", f"Line {number} of the document list is not JSON: {error}.",
                          "Pass 'maelys-platform docs --prose --only PRODUCT --format jsonl'.") from error
        missing = [key for key in ("repository", "path", "destination") if not isinstance(record.get(key), str)]
        if missing:
            raise Failure("VALIDATION_FAILED", f"Record {number} has no {', '.join(missing)}.",
                          "Pass 'maelys-platform docs --prose --only PRODUCT --format jsonl'.")
        records.append(record)
    if not records:
        raise Failure("VALIDATION_FAILED", "The document list is empty.",
                      "Pass 'maelys-platform docs --prose --only PRODUCT --format jsonl'; nothing to move is not a migration.")
    return records


def referencing_files(project: pathlib.Path, relative: str) -> list[str]:
    """Files of the product that still name this document, which the move breaks."""
    completed = run(["git", "grep", "-l", "--fixed-strings", "--", relative], cwd=project)
    return [line for line in completed.stdout.splitlines() if line and line != relative]


def migration_plan(invocation: Invocation) -> dict:
    project, product, _ = project_of(invocation)
    records = read_prose_records(str(invocation.option("--documents", "-")))
    foreign = sorted({record["repository"] for record in records} - {product})
    if foreign:
        raise Failure("VALIDATION_FAILED", f"The list carries documents of {', '.join(foreign)}, not {product}.",
                      f"Pass 'maelys-platform docs --prose --only {product} --format jsonl'.")
    repository = str(invocation.option("--documents-repository", DEFAULT_DOCUMENTS))
    moving, unknown = [], []
    for record in records:
        relative = record["path"]
        destination = record["destination"]
        expected = f"{repository.split('/')[-1]}/{product}/{relative[len('docs/'):]}"
        if not relative.startswith("docs/") or destination != expected:
            unknown.append(f"{relative} -> {destination} (expected {expected})")
            continue
        if not (project / relative).is_file():
            unknown.append(f"{relative} is not a file of {product}")
            continue
        moving.append({"path": relative, "destination": destination,
                       "referencedBy": referencing_files(project, relative)})
    if unknown:
        raise Failure("VALIDATION_FAILED", "The list does not describe this migration: " + "; ".join(unknown) + ".",
                      "Regenerate it with maelys-platform for this product.")
    # What the product keeps, and on which ground: the plan says it before
    # anything is written, so the operator judges the whole docs/ at once.
    decl = read_declarations(project, product, declared_mechanism(project))
    moved = {entry["path"] for entry in moving}
    staying = []
    docs = project / "docs"
    for path in sorted(docs.rglob("*")) if docs.is_dir() else []:
        relative = path.relative_to(project).as_posix()
        if not path.is_file() or relative in moved:
            continue
        if relative == CLI_REFERENCE or relative == CLI_CONTRACT:
            reason = "the generated command-line reference and its contract"
        elif path.suffix.lower() != ".md":
            reason = "data, not prose"
        elif is_generated(path.read_text(encoding="utf-8")):
            reason = "generated: its head says so"
        elif relative in engaged_documents(project):
            reason = "LICENSING.md engages it publicly"
        else:
            reason = "not in the list maelys-platform produced"
        staying.append({"path": relative, "reason": reason})
    version = decl.version
    tag = git("describe", "--tags", "--abbrev=0", cwd=project, check=False) or ""
    commit = git("rev-parse", "HEAD", cwd=project, check=False)
    return {"mode": "plan", "product": product, "project": str(project), "repository": repository,
            "version": version, "tag": tag, "commit": commit,
            "moving": moving, "staying": staying, "documents": len(moving)}


def push_branch(clone: pathlib.Path, remote: str, branch: str) -> None:
    """Send `branch` to `remote`, replacing an earlier attempt but nothing else.

    --force-with-lease needs to know what the remote holds, and a clone that
    has never fetched the branch knows nothing: it refuses on stale info,
    which is what a second run of a migration hits. The branch is fetched
    first, so the lease is judged against the ref it names.
    """
    run(["git", "fetch", "-q", remote, f"+refs/heads/{branch}:refs/remotes/lease/{branch}"], cwd=clone)
    known = run(["git", "rev-parse", "--verify", "-q", f"refs/remotes/lease/{branch}"], cwd=clone).stdout.strip()
    lease = f"--force-with-lease=refs/heads/{branch}:{known}" if known else "--force-with-lease"
    git("push", "-q", lease, remote, f"HEAD:refs/heads/{branch}", cwd=clone)


def rewrite_readme(clone: pathlib.Path, product: str, data: dict) -> str:
    """Point the README at the prose that left, and say nothing more.

    The socle does not rewrite a product's own README: it cannot say what the
    product is. It replaces the links to the documents that moved with one
    line naming where they went, and leaves every other section untouched.
    """
    readme = clone / "README.md"
    if not readme.is_file():
        return "absent"
    moved = {entry["path"] for entry in data["moving"]}
    kept, dropped = [], 0
    for line in readme.read_text(encoding="utf-8").split("\n"):
        if any(path in line for path in moved):
            dropped += 1
            continue
        kept.append(line)
    if not dropped:
        return "unchanged: it named none of them"
    text = "\n".join(kept)
    pointer = (f"The documentation of {product} is in `{data['repository']}`, directory `{product}/`.\n")
    if "\n## Documentation\n" in text:
        head, _, tail = text.partition("\n## Documentation\n")
        rest = tail.split("\n## ", 1)
        text = head + "\n## Documentation\n\n" + pointer + ("\n## " + rest[1] if len(rest) > 1 else "")
    else:
        text = text.rstrip("\n") + "\n\n## Documentation\n\n" + pointer
    readme.write_text(re.sub(r"\n{3,}", "\n\n", text).rstrip("\n") + "\n", encoding="utf-8")
    return f"{dropped} link lines replaced by one pointer"


def handle_migrate(invocation: Invocation) -> tuple[dict, int]:
    """Move a product's prose into maelys-docs, with its history, and out of the product.

    Both sides of one move: without the removal the prose is duplicated, and
    without the addition it is lost. maelys-docs receives a branch carrying
    the rewritten history; the product receives a pull request, never a
    direct write.
    """
    data = migration_plan(invocation)
    if not invocation.flag("--apply"):
        return data, EXIT_OK
    data["mode"] = "apply"
    if not data["tag"]:
        raise Failure("PRECONDITION_FAILED",
                      f"{data['product']} has no tag, so the prose would describe no release.",
                      "Release the product first: maelys-docs pins the tag whose prose it carries.")
    project = pathlib.Path(data["project"])
    product = data["product"]
    base = os.environ.get("MAELYS_GIT_BASE", "https://github.com/maelys-dev")
    branch = f"migrate/{product}"
    with tempfile.TemporaryDirectory(prefix="maelys-release-migrate.") as temp:
        work = pathlib.Path(temp)
        # The history is rewritten on a throwaway clone of the product, never
        # on the product itself: filter-repo rewrites every commit it keeps.
        source = work / "source"
        git("clone", "-q", str(project), str(source))
        paths = [argument for entry in data["moving"] for argument in ("--path", entry["path"])]
        run(["git", "filter-repo", *paths, "--path-rename", f"docs/:{product}/", "--force"], cwd=source)
        if not (source / product).is_dir():
            raise Failure("FAILED", "git filter-repo left no history on the new path.",
                          "Check that git-filter-repo is installed and that the documents are tracked.")
        documents = work / "documents"
        git("clone", "-q", f"{base}/{data['repository'].split('/')[-1]}.git", str(documents))
        git("config", "user.name", os.environ.get("GIT_AUTHOR_NAME", PROGRAM), cwd=documents)
        git("config", "user.email", os.environ.get("GIT_AUTHOR_EMAIL", f"{PROGRAM}@maelys.dev"), cwd=documents)
        git("checkout", "-q", "-B", branch, cwd=documents)
        git("remote", "add", "source", str(source), cwd=documents)
        git("fetch", "-q", "source", cwd=documents)
        head = git("rev-parse", "source/HEAD", cwd=documents, check=False) or git("rev-parse", "source/main", cwd=documents)
        git("merge", "--allow-unrelated-histories", "--no-edit", "-q", head, cwd=documents)
        # The pin says which release of the product this prose describes, in
        # the one format the fleet uses: dependencies/<name>.pin, tag on line
        # 1 and commit on line 2. The socle refuses adapter/<NAME>_PIN in a
        # product since 0.14.0, so it does not write one here either.
        (documents / "dependencies").mkdir(exist_ok=True)
        (documents / "dependencies" / f"{product}.pin").write_text(
            f"{data['tag']}\n{data['commit']}\n", encoding="utf-8")
        (documents / product / "VERSION").write_text(f"{data['version']}\n", encoding="utf-8")
        git("add", "-A", cwd=documents)
        git("-c", "commit.gpgsign=false", "commit", "-q", "-m",
            f"{product}: the prose of {data['tag'] or data['commit'][:7]}, with its history", cwd=documents)
        data["documentsBranch"] = branch
        data["documentsCommit"] = git("rev-parse", "HEAD", cwd=documents)

        # The product side: the same move, seen from the repository that
        # loses the documents. It travels as a branch for a pull request,
        # never as a write into the operator's checkout.
        product_clone = work / "product"
        git("clone", "-q", str(project), str(product_clone))
        git("config", "user.name", os.environ.get("GIT_AUTHOR_NAME", PROGRAM), cwd=product_clone)
        git("config", "user.email", os.environ.get("GIT_AUTHOR_EMAIL", f"{PROGRAM}@maelys.dev"), cwd=product_clone)
        git("checkout", "-q", "-B", branch, cwd=product_clone)
        for entry in data["moving"]:
            git("rm", "-q", "--", entry["path"], cwd=product_clone)
        data["readme"] = rewrite_readme(product_clone, product, data)
        git("add", "-A", cwd=product_clone)
        git("-c", "commit.gpgsign=false", "commit", "-q", "-m",
            f"docs: the prose moves to {data['repository']}/{product}/\n\n"
            f"{data['documents']} documents, with their history, are now in {data['repository']}."
            " This side removes them and points the README there.", cwd=product_clone)
        data["productBranch"] = branch
        data["productCommit"] = git("rev-parse", "HEAD", cwd=product_clone)

        data["pushed"] = bool(invocation.flag("--push"))
        if data["pushed"]:
            push_branch(documents, "origin", branch)
            # The clone was made from the operator's checkout, so its origin
            # is a local path: the product's own remote is asked for here.
            remote = git("remote", "get-url", "origin", cwd=project, check=False) or f"{base}/{product}.git"
            push_branch(product_clone, remote, branch)
        else:
            # Without --push both sides stay reviewable on disk: a migration
            # writes into two repositories, so it is never pushed by default.
            kept = pathlib.Path(os.environ.get("XDG_CACHE_HOME") or pathlib.Path.home() / ".cache") \
                / "maelys-release" / f"migrate-{product}"
            shutil.rmtree(kept, ignore_errors=True)
            kept.mkdir(parents=True)
            shutil.copytree(documents, kept / "documents")
            shutil.copytree(product_clone, kept / "product")
            data["kept"] = str(kept)
    return data, EXIT_OK


def handle_new(invocation: Invocation) -> tuple[dict, int]:
    """Create a Maelys repository: the base files, then the socle's own."""
    directory = pathlib.Path(invocation.operands[0])
    product = str(invocation.option("--product", "")) or directory.name
    if not re.fullmatch(r"[a-z0-9-]+", product):
        raise Failure("VALIDATION_FAILED", f"Product name must be [a-z0-9-]: {product}.",
                      "Pass --product NAME with a valid name.")
    apply = invocation.flag("--apply")
    mechanism = str(invocation.option("--mechanism", "")) or SOCLE_MECHANISM
    if mechanism not in MECHANISMS:
        raise Failure("VALIDATION_FAILED", f"Unknown mechanism: {mechanism}.",
                      "Pass --mechanism maelys-release, custom or none.")
    if directory.exists():
        remaining = [path.name for path in directory.iterdir() if path.name != ".git"]
        if remaining:
            raise Failure("PRECONDITION_FAILED", f"{directory} is not empty: {', '.join(sorted(remaining)[:5])}.",
                          f"'{PROGRAM} new' creates a repository; run 'adopt' on one that exists.")
    dependencies = [resolve_dependency(str(spec)) for spec in invocation.option("--depends", [])]
    files = scaffold(directory, product, dependencies)
    written: list[dict] = []
    for relative, content in files.items():
        entry = {"path": relative, "action": "create", "scope": "conventions"}
        if apply:
            path = directory / relative
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content, encoding="utf-8")
            if relative.startswith("scripts/"):
                path.chmod(path.stat().st_mode | 0o111)
        written.append(entry)
    data: dict = {"mode": "apply" if apply else "plan", "product": product, "project": str(directory),
                  "mechanism": mechanism, "version": "0.1.0",
                  "dependencies": [{"name": name, "tag": tag, "commit": commit}
                                   for name, tag, commit in dependencies],
                  "files": written, "adopted": []}
    if not apply:
        return data, EXIT_OK
    # The socle's own files come from adopt, so new and adopt can never
    # disagree on what a repository carries.
    sha, tag = socle_identity(str(invocation.option("--socle-sha", "")), str(invocation.option("--socle-tag", "")))
    decl = read_declarations(directory.resolve(), product, mechanism)
    require_valid(decl, "new")
    data["adopted"] = plan(decl, stage(decl, sha, tag), apply=True)
    data["socle"] = socle_data(sha, tag)
    return data, EXIT_OK


def handle_adopt(invocation: Invocation) -> tuple[dict, int]:
    project, product, mechanism = project_of(invocation)
    apply = invocation.flag("--apply")
    decl = read_declarations(project, product, mechanism)
    require_valid(decl, "adopt")
    sha, tag = socle_identity(str(invocation.option("--socle-sha", "")), str(invocation.option("--socle-tag", "")))
    # A product pins releases of the socle: a commit without a tag has no
    # changelog entry, no trial and no compatibility promise. Trials of a
    # candidate say so explicitly.
    if decl.releases_here and tag == "untagged" and not invocation.option("--socle-sha") \
            and not invocation.flag("--allow-untagged"):
        described = git("describe", "--tags", "--always", cwd=socle_root(), check=False) or sha[:7]
        raise Failure("PRECONDITION_FAILED", f"This socle is {described}, not a release: a product pins tagged versions only.",
                      "Check out a tag of maelys-release, or pass --allow-untagged for a trial of a candidate.")
    files = plan(decl, stage(decl, sha, tag), apply)
    changed = any(entry["action"] != "same" for entry in files)
    return {"mode": "apply" if apply else "plan", "product": product, "project": str(project),
            "mechanism": mechanism, "socle": socle_data(sha, tag), "changed": changed,
            "checks": decl.applicable(), "files": files}, EXIT_OK


def check_data(invocation: Invocation) -> tuple[Declarations, dict]:
    project, product, mechanism = project_of(invocation)
    run_pinned_socle(invocation, project)
    decl = read_declarations(project, product, mechanism)
    sha, tag = socle_identity(str(invocation.option("--socle-sha", "")), str(invocation.option("--socle-tag", "")))
    pinned = pinned_socle(project)
    # A socle fetched by commit alone (a depth-1 fetch in CI) knows no tag;
    # the tag is only a label next to the pinned commit, so when the commits
    # agree the product's label stands and regeneration compares content.
    if tag == "untagged" and pinned and pinned["sha"] == sha:
        tag = pinned["tag"]
    # Two verdicts: the conventions, which hold for every product, and the
    # release mechanism, which holds only for a product the socle releases.
    conventions: list[str] = []
    release: list[str] = []
    data: dict = {"product": product, "project": str(project), "mechanism": decl.mechanism,
                  "socle": socle_data(sha, tag), "pinned": pinned, "checks": decl.applicable(),
                  "files": [], "violations": []}
    for check in decl.applicable():
        if check["status"] not in ("ok", "note"):
            (conventions if check["scope"] == "conventions" else release).append(check["message"])
    if decl.valid:
        if decl.releases_here and data["pinned"] and data["pinned"]["sha"] != sha:
            release.append(
                f"{product} pins maelys-release {data['pinned']['tag']} ({data['pinned']['sha'][:7]}) but this is"
                f" {tag} ({sha[:7]}): run the pinned socle, or 'adopt {project} --apply' from this one to upgrade")
        else:
            data["files"] = plan(decl, stage(decl, sha, tag), apply=False)
            for entry in data["files"]:
                if entry["action"] == "same":
                    continue
                # A seeded file is written once and owned by the product
                # afterwards: adopt offers it, check never demands it.
                if entry.get("seeded"):
                    decl.add("note", f"{entry['path']}: absent; 'adopt --apply' writes it once", "conventions")
                    continue
                message = f"{entry['path']}: {entry['action']}" + (f" ({entry['reason']})" if "reason" in entry else "")
                (conventions if entry["scope"] == "conventions" else release).append(message)
    # The documentation contract is opt-in while maelys-docs does not exist:
    # a product cannot move prose to a repository nobody has created yet, so
    # check names the destination and only refuses when asked to.
    if invocation.flag("--docs-contract"):
        conventions.extend(f"{relative}: prose belongs in maelys-docs/{product}/{relative[len('docs/'):]};"
                           f" move it with '{PROGRAM} migrate'"
                           for relative in decl.prose)
        conventions.extend(f"{name}: the generated CLI reference is {CLI_REFERENCE} for every product"
                           for name in LEGACY_CLI_REFERENCES if (project / name).is_file())
    # The seeded notes are added while planning, so the checks are taken last.
    data["checks"] = decl.applicable()
    data["conventions"] = {"valid": not conventions, "violations": conventions}
    if not decl.releases_here and release:
        raise Failure("FAILED", "A release-scope violation was reported for a product the socle does not release: "
                      + "; ".join(release) + ".",
                      "This is a defect of the socle: the exit code would contradict the verdict shown.")
    data["release"] = {"applicable": decl.releases_here, "valid": not release, "violations": release}
    data["violations"] = conventions + release
    data["valid"] = not data["violations"]
    return decl, data


def handle_declarations(invocation: Invocation) -> tuple[dict, int]:
    """The product contract as data, for a CI job that installs what it declares."""
    project, product, mechanism = project_of(invocation)
    decl = read_declarations(project, product, mechanism)
    return {"valid": decl.valid, "product": product, "project": str(project), "version": decl.version,
            "mechanism": mechanism,
            "dependencies": decl.dependencies, "linuxPackages": decl.linux_packages,
            "macosPackages": decl.macos_packages, "formulas": decl.formulas, "checks": decl.applicable()}, \
        EXIT_OK if decl.valid else EXIT_VIOLATIONS


def handle_check(invocation: Invocation) -> tuple[dict, int]:
    _, data = check_data(invocation)
    return data, EXIT_OK if data["valid"] else EXIT_VIOLATIONS


def github_api(path: str) -> dict | None:
    """GET through gh (its credentials); None when gh is missing or the call fails."""
    if not shutil.which("gh"):
        return None
    completed = run(["gh", "api", path])
    return json.loads(completed.stdout) if completed.returncode == 0 else None


def handle_preflight(invocation: Invocation) -> tuple[dict, int]:
    """What the release workflow will demand of the tag, before it exists."""
    decl, data = check_data(invocation)
    project = decl.project
    require_socle_mechanism(project, decl.mechanism, "preflight")
    preflight: list[dict] = []

    def add(status: str, message: str) -> None:
        preflight.append({"status": status, "message": message})

    def config(key: str) -> str:
        return git("config", "--get", key, cwd=project, check=False)

    if data["valid"]:
        add("ok" if config("tag.gpgsign") == "true" else "fail",
            "tag.gpgsign = true" if config("tag.gpgsign") == "true" else "tag.gpgsign is not true: git config tag.gpgsign true")
        fmt = config("gpg.format") or "openpgp"
        if config("user.signingkey"):
            add("ok", f"gpg.format = {fmt}, user.signingkey set")
        else:
            add("fail", f"user.signingkey is not set (gpg.format = {fmt}); the key must be registered on GitHub")
        if git("rev-parse", "--is-shallow-repository", cwd=project, check=False) == "true":
            add("fail", "shallow clone: previous tags are not visible; run from a full clone")
        else:
            tags = git("tag", "--list", "v*", "--sort=-v:refname", cwd=project, check=False).split()
            if not tags:
                add("note", "no v* tag yet")
            else:
                last = tags[0]
                if git("cat-file", "-t", last, cwd=project, check=False) != "tag":
                    add("fail", f"{last} is a lightweight tag; the workflow requires annotated signed tags")
                elif not re.search(r"-----BEGIN .*SIGNATURE-----", git("cat-file", "-p", last, cwd=project, check=False)):
                    add("fail", f"{last} is not signed")
                else:
                    add("ok", f"{last} is annotated and signed")
        if git("rev-parse", "-q", "--verify", f"refs/tags/v{decl.version}", cwd=project, check=False):
            add("fail", f"tag v{decl.version} already exists; bump VERSION")
        else:
            add("ok", f"tag v{decl.version} is free")
        # GitHub creates a missing environment on first use, without rules,
        # so presence proves nothing: the environment must limit deployments
        # to tags v*, which keeps a workflow_dispatch from a branch or a
        # release.yml edited on a branch from publishing.
        remote = git("remote", "get-url", "origin", cwd=project, check=False)
        match = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?$", remote)
        if not match:
            add("note", "origin is not on GitHub: release environment not checked")
        elif not shutil.which("gh"):
            add("note", f"gh is not installed: release environment of {match.group(1)} not checked")
        else:
            repository = match.group(1)
            repository_data = github_api(f"repos/{repository}") or {}
            if repository_data.get("private"):
                add("note", f"{repository} is private: the release ships no provenance attestation (GitHub reserves"
                    " them to paid plans); the signed tag and SHA256SUMS remain")
            environment = github_api(f"repos/{repository}/environments/release")
            if environment is None:
                add("fail", f"environment release is missing in {repository}; create it and limit its deployments to tags v*")
            elif not (environment.get("deployment_branch_policy") or {}).get("custom_branch_policies"):
                add("fail", f"environment release of {repository} has no deployment policy: any branch,"
                    " workflow_dispatch or edited release.yml can publish; limit it to tags v*")
            else:
                policies = github_api(f"repos/{repository}/environments/release/deployment-branch-policies") or {}
                if any(policy.get("type") == "tag" and policy.get("name") == "v*"
                       for policy in policies.get("branch_policies", [])):
                    add("ok", f"environment release of {repository} limits deployments to tags v*")
                else:
                    add("fail", f"environment release of {repository} has a deployment policy without the tag rule v*")
    data["preflight"] = preflight
    data["violations"].extend(item["message"] for item in preflight if item["status"] == "fail")
    data["ready"] = data["valid"] and not any(item["status"] == "fail" for item in preflight)
    return data, EXIT_OK if data["ready"] else EXIT_VIOLATIONS


REHEARSAL = r"""
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
echo "== Install Linux packaging tools and declared packages"
apt-get update -q >/dev/null
# git and certificates are on the runner already; the image has neither.
apt-get install -y -q --no-install-recommends git ca-certificates $LINUX_PACKAGES >/dev/null
echo "== Copy the working tree (dist/ excluded)"
mkdir -p /work/product && cd /work/product
tar -C /src --exclude=./dist -cf - . | tar -xf -
git config --global --add safe.directory "*"
echo "== Pinned dependency checkouts"
for name in $DEPENDENCIES; do sh scripts/checkout-dependency.sh "$name"; done
if [ "$REHEARSE_MODE" = check ]; then
    echo "== Check: $CHECK_COMMAND"
    eval "$CHECK_COMMAND"
    exit 0
fi
echo "== Package: ${PACKAGE_COMMAND//TARGET/$TARGET}"
eval "${PACKAGE_COMMAND//TARGET/$TARGET}"
test -n "$(ls dist 2>/dev/null)" || { echo "rehearse: dist/ is empty" >&2; exit 1; }
cp dist/* /dist/
echo "== Artifacts in dist/"
ls -l /dist
"""


def handle_rehearse(invocation: Invocation) -> tuple[dict, int]:
    """Replay the build job of release.yml for one Linux target in Docker."""
    project, product, mechanism = project_of(invocation)
    run_pinned_socle(invocation, project)
    target = invocation.operands[1]
    require_socle_mechanism(project, mechanism, "rehearse")
    if not shutil.which("docker"):
        raise Failure("NOT_FOUND", "docker is required to rehearse a Linux build.", "Install Docker and retry.")
    decl = read_declarations(project, product, mechanism)
    require_valid(decl, "rehearse")
    if decl.dependencies and not os.access(project / "scripts" / "checkout-dependency.sh", os.X_OK):
        raise Failure("PRECONDITION_FAILED", "scripts/checkout-dependency.sh is missing in the product.",
                      f"Run '{PROGRAM} adopt {project} --apply' first.")
    (project / "dist").mkdir(exist_ok=True)
    image = str(invocation.option("--image", os.environ.get("REHEARSE_IMAGE", DEFAULT_IMAGE)))
    package_command = str(invocation.option("--package-command", "bash scripts/package-release.sh TARGET"))
    mode = "check" if invocation.flag("--check") else "package"
    check_command = str(invocation.option("--check-command", "make check"))
    command = ["docker", "run", f"--name=rehearse-{target}" if invocation.flag("--keep") else "--rm",
               "--platform", PLATFORMS[target],
               "-v", f"{project}:/src:ro", "-v", f"{project / 'dist'}:/dist",
               "-e", f"TARGET={target}",
               "-e", f"LINUX_PACKAGES={SOCLE_LINUX_PACKAGES} {decl.linux_packages}".rstrip(),
               "-e", f"DEPENDENCIES={' '.join(decl.dependencies)}",
               "-e", f"PACKAGE_COMMAND={package_command}",
               "-e", f"REHEARSE_MODE={mode}", "-e", f"CHECK_COMMAND={check_command}",
               image, "bash", "-c", REHEARSAL]
    # The container's output is a log: it stays on stdout for a human and
    # moves to stderr when the envelope owns stdout.
    log = sys.stderr if invocation.format != "text" else sys.stdout
    print(f"rehearse: {mode} {target} on {image} ({PLATFORMS[target]})", file=log)
    log.flush()
    completed = subprocess.run(command, check=False, stdout=log, stderr=subprocess.STDOUT)
    if completed.returncode != 0:
        raise Failure("PROCESS_FAILED", f"The rehearsal of {target} failed with exit {completed.returncode}.",
                      "Read the container log above; fix the product and retry.")
    artifacts = [] if mode == "check" else sorted(path.name for path in (project / "dist").iterdir() if target in path.name)
    return {"product": product, "target": target, "platform": PLATFORMS[target], "image": image, "mode": mode,
            "artifacts": artifacts}, EXIT_OK


def handle_render(invocation: Invocation) -> tuple[dict, int]:
    template, output = pathlib.Path(invocation.operands[0]), pathlib.Path(invocation.operands[1])
    mapping: dict[str, str] = {}
    for pair in invocation.operands[2:]:
        key, separator, value = pair.partition("=")
        if not separator or not re.fullmatch(r"[A-Z0-9_]+", key):
            raise Failure("VALIDATION_FAILED", f"Placeholder assignments are KEY=VALUE with KEY in [A-Z0-9_]: {pair}.",
                          "Use the synopsis returned by describe and retry.")
        mapping[key] = value
    if not template.is_file():
        raise Failure("NOT_FOUND", f"Template not found: {template}.", "Pass an existing template file.")
    text = render_text(template, mapping)
    left = sorted(set(re.findall(r"@[A-Z0-9_]*@", text)))
    if left:
        raise Failure("VALIDATION_FAILED", f"Unrendered placeholders in {template}: {' '.join(left)}.",
                      "Pass a KEY=VALUE for each of them.")
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(text, encoding="utf-8")
    return {"template": str(template), "output": str(output), "placeholders": sorted(mapping)}, EXIT_OK


def push_rebased(tap: pathlib.Path, branch: str, attempts: int = 3) -> int:
    """Push HEAD of the tap clone to BRANCH; after a rejected push, fetch,
    rebase onto the branch and push again, ATTEMPTS times at most.

    Returns the number of attempts the push took. Every product owns its own
    Formula/NAME.rb, so the rebase conflicts only when the same formula is
    published twice at once, which the signed-tag model excludes: the rebase
    is then aborted and the publication fails instead of guessing. The
    publish step of tap.yml does the same in shell.
    """
    pushed = None
    for attempt in range(1, attempts + 1):
        pushed = run(["git", "push", "-q", "origin", f"HEAD:{branch}"], cwd=tap)
        if pushed.returncode == 0:
            return attempt
        if attempt == attempts:
            break
        git("fetch", "-q", "origin", branch, cwd=tap)
        if run(["git", "rebase", "-q", f"origin/{branch}"], cwd=tap).returncode != 0:
            run(["git", "rebase", "--abort"], cwd=tap)
            raise Failure("PROCESS_FAILED", f"Rebasing onto origin/{branch} conflicts: the tap received another"
                          " change of the same formula.", "Read the tap's history of the formula, then publish again.")
    raise Failure("PROCESS_FAILED", f"git push to {branch} of the tap was rejected {attempts} times:"
                  f" {pushed.stderr.strip()}", "Check the tap's branch rules and the credentials, then publish again.")


def handle_tap(invocation: Invocation) -> tuple[dict, int]:
    """Plan or publish one rendered formula into the tap with a signed commit."""
    product, tag, formula = invocation.operands[0], invocation.operands[1], pathlib.Path(invocation.operands[2])
    apply = invocation.flag("--apply")
    if not re.fullmatch(r"v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?", tag):
        raise Failure("VALIDATION_FAILED", f"TAG is vX.Y.Z or vX.Y.Z-PRERELEASE: {tag}.", "Pass the release tag.")
    if not formula.is_file():
        raise Failure("NOT_FOUND", f"Rendered formula not found: {formula}.", "Render the formula first.")
    version = tag[1:]
    repository = os.environ.get("TAP_REPOSITORY", DEFAULT_TAP)
    token = os.environ.get("TAP_TOKEN", "")
    url = os.environ.get("TAP_URL") or (
        f"https://x-access-token:{token}@github.com/{repository}.git" if token
        else f"https://github.com/{repository}.git")
    owner, _, name = repository.partition("/")
    data: dict = {"mode": "apply" if apply else "plan", "product": product, "version": version,
                  "repository": repository, "formula": f"Formula/{product}.rb", "changed": False}
    with tempfile.TemporaryDirectory(prefix="maelys-release-tap.") as temp:
        tap = pathlib.Path(temp) / "tap"
        git("clone", "-q", url, str(tap))
        (tap / "Formula").mkdir(exist_ok=True)
        shutil.copyfile(formula, tap / "Formula" / f"{product}.rb")
        if shutil.which("brew") and not invocation.flag("--skip-style"):
            style = run(["brew", "style", str(tap / "Formula" / f"{product}.rb")])
            if style.returncode != 0:
                raise Failure("VALIDATION_FAILED", f"brew style refused the formula: {style.stdout.strip()}",
                              "Fix the formula template and render it again.")
        git("add", f"Formula/{product}.rb", cwd=tap)
        if run(["git", "diff", "--cached", "--quiet"], cwd=tap).returncode == 0:
            return data, EXIT_OK
        data["changed"] = True
        data["diff"] = git("diff", "--cached", cwd=tap)
        if not apply:
            return data, EXIT_OK
        # Identity and signing live in the clone's configuration, so the
        # commit and any rebase of it are signed alike.
        git("config", "user.name", os.environ.get("GIT_AUTHOR_NAME", PROGRAM), cwd=tap)
        git("config", "user.email", os.environ.get("GIT_AUTHOR_EMAIL", f"{PROGRAM}@users.noreply.github.com"), cwd=tap)
        key = os.environ.get("TAP_SIGNING_KEY", "")
        if key:
            key_file = pathlib.Path(temp) / "signing-key"
            key_file.write_text(key + "\n", encoding="utf-8")
            key_file.chmod(0o600)
            git("config", "gpg.format", "ssh", cwd=tap)
            git("config", "user.signingkey", str(key_file), cwd=tap)
            git("config", "commit.gpgsign", "true", cwd=tap)
        git("commit", "-q", "-m", f"Update {product} to {version}", cwd=tap)
        data["pushAttempts"] = push_rebased(tap, "main")
        # The rebase of a retried push rewrites the commit: report what the tap holds.
        data["commit"] = git("rev-parse", "HEAD", cwd=tap)
    data["install"] = f"brew install {owner}/{name.replace('homebrew-', '', 1)}/{product}"
    return data, EXIT_OK


def handle_self_test(invocation: Invocation) -> tuple[dict, int]:
    tests = socle_root() / "tests"
    if not tests.is_dir():
        raise Failure("NOT_FOUND", f"{tests} is not part of this installation.", "Run from a maelys-release checkout.")
    command = [sys.executable, "-W", "error", "-m", "unittest", "discover", "-s", str(tests)]
    if invocation.flag("--verbose"):
        command.append("-v")
    log = sys.stderr if invocation.format != "text" else sys.stdout
    log.flush()
    completed = subprocess.run(command, check=False, stdout=log, stderr=subprocess.STDOUT)
    if completed.returncode != 0:
        raise Failure("PROCESS_FAILED", f"The self-test failed with exit {completed.returncode}.", "Read the report above.")
    return {"tests": str(tests), "passed": True}, EXIT_OK


# ---- the vendored framework ---------------------------------------------------

def vendored_pin() -> tuple[str, str, str]:
    """(tag, commit, sha256) of dependencies/maelys-cli.pin; the third line may be absent."""
    lines = (socle_root() / "dependencies" / "maelys-cli.pin").read_text(encoding="utf-8").split()
    digest = lines[2].partition(":")[2] if len(lines) > 2 else ""
    return lines[0], lines[1], digest


def handle_vendor(invocation: Invocation) -> tuple[dict, int]:
    """Refresh bin/maelys_cli.py from maelys-cli at the pinned commit, and record its digest."""
    del invocation
    tag, commit, previous = vendored_pin()
    base = os.environ.get("MAELYS_GIT_BASE", "https://github.com/maelys-dev")
    with tempfile.TemporaryDirectory(prefix="maelys-release-vendor.") as temp:
        work = pathlib.Path(temp)
        git("init", "-q", str(work))
        git("fetch", "-q", "--depth", "1", f"{base}/maelys-cli.git", commit, cwd=work)
        shown = run(["git", "show", "FETCH_HEAD:python/maelys_cli.py"], cwd=work)
        if shown.returncode != 0:
            raise Failure("NOT_FOUND", f"python/maelys_cli.py is not in maelys-cli at {commit[:7]}.",
                          "Pin a maelys-cli release that ships the Python framework (0.5.12 or later).")
        content = shown.stdout.encode("utf-8")
    digest = hashlib.sha256(content).hexdigest()
    target = socle_root() / "bin" / "maelys_cli.py"
    changed = not target.is_file() or target.read_bytes() != content or previous != digest
    target.write_bytes(content)
    (socle_root() / "dependencies" / "maelys-cli.pin").write_text(f"{tag}\n{commit}\nsha256:{digest}\n", encoding="utf-8")
    return {"tag": tag, "commit": commit, "sha256": digest, "path": str(target), "changed": changed}, EXIT_OK


# ---- text renderers ----------------------------------------------------------

LABELS = {"ok": "ok", "note": "note", "warn": "WARN", "missing": "MISSING", "refused": "REFUSED", "fail": "FAIL"}


def checks_text(checks: list[dict]) -> str:
    return "".join(f"{LABELS.get(check['status'], check['status']):<8} {check['message']}\n" for check in checks)


def text_adopt(data: dict) -> str:
    lines = []
    for entry in data["files"]:
        lines.append(f"{entry['action']:<8} {entry['path']}" + (f" ({entry['reason']})" if "reason" in entry else ""))
        if data["mode"] == "plan" and entry.get("diff"):
            lines.extend("         " + line for line in entry["diff"].rstrip("\n").split("\n"))
    tag = data["socle"]["tag"]
    scope = "conventions" if data["mechanism"] != SOCLE_MECHANISM else "conventions and release files"
    if data["mode"] == "apply":
        lines.append(f"adopt: wrote the {scope} of maelys-release {tag} into {data['project']}"
                     f" ({data['mechanism']} mechanism)")
    elif data["changed"]:
        lines.append("adopt: plan only; add --apply to write")
    else:
        lines.append("adopt: nothing to do")
    return checks_text(data["checks"]) + "\n".join(lines) + "\n"


def text_check(data: dict, with_checks: bool = True) -> str:
    lines = [f"{entry['action']:<8} {entry['path']}" + (f" ({entry['reason']})" if "reason" in entry else "")
             for entry in data["files"]]
    conventions = "ok" if data["conventions"]["valid"] else "FAIL"
    release = ("ok" if data["release"]["valid"] else "FAIL") if data["release"]["applicable"] \
        else f"not applicable ({data['mechanism']} mechanism)"
    lines.append(f"verdict  conventions: {conventions}")
    lines.append(f"verdict  release mechanism: {release}")
    if data["valid"]:
        if data["release"]["applicable"]:
            lines.append(f"check: {data['product']} is on maelys-release {data['socle']['tag']}")
        else:
            lines.append(f"check: {data['product']} follows the conventions of maelys-release {data['socle']['tag']}")
    else:
        # the contract lines and the file lines already show their violations
        shown = {check["message"] for check in data["checks"]}
        shown.update(f"{entry['path']}: {entry['action']}" + (f" ({entry['reason']})" if "reason" in entry else "")
                     for entry in data["files"])
        lines.extend(f"drift    {violation}" for violation in data["violations"] if violation not in shown)
        lines.append(f"check: {data['product']} drifts from maelys-release {data['socle']['tag']}")
    return (checks_text(data["checks"]) if with_checks else "") + "\n".join(lines) + "\n"


def text_preflight(data: dict) -> str:
    # the check part first, with its drift lines when it fails; then the tag preconditions
    lines = [text_check(data).rstrip("\n")]
    lines.extend(f"{LABELS[item['status']]:<8} {item['message']}" for item in data["preflight"])
    state = "ready to tag" if data["ready"] else "not ready to tag"
    lines.append(f"preflight: {data['product']} is {state}")
    return "\n".join(lines) + "\n"


def text_declarations(data: dict) -> str:
    return checks_text(data["checks"]) + "".join(f"{key:<13} {value}\n" for key, value in (
        ("dependencies", " ".join(data["dependencies"])), ("linux", data["linuxPackages"]),
        ("macos", data["macosPackages"]), ("formulas", " ".join(data["formulas"]))))


def text_tap(data: dict) -> str:
    if not data["changed"]:
        return f"tap already carries {data['product']} {data['version']}\n"
    if data["mode"] == "plan":
        return data["diff"] + "\ntap: plan only; add --apply to commit and push\n"
    return f"{data['install']}\n"


def text_new(data: dict) -> str:
    lines = [f"create   {entry['path']}" for entry in data["files"]]
    lines.extend(f"{entry['action']:<8} {entry['path']}" for entry in data["adopted"])
    for dependency in data["dependencies"]:
        lines.append(f"pin      dependencies/{dependency['name']}.pin"
                     f" {dependency['tag']} ({dependency['commit'][:7]})")
    if data["mode"] == "plan":
        lines.append(f"new: plan only; add --apply to create {data['product']} in {data['project']}")
    else:
        lines.append(f"new: {data['product']} {data['version']} created in {data['project']}"
                     f" ({data['mechanism']} mechanism)")
        lines.append("next: write scripts/package-release.sh and a Makefile whose 'check' passes,"
                     " then commit and open the repository")
    return "\n".join(lines) + "\n"


def text_migrate(data: dict) -> str:
    lines = [f"move     {entry['path']} -> {entry['destination']}"
             + (f"  (still named by {', '.join(entry['referencedBy'])})" if entry["referencedBy"] else "")
             for entry in data["moving"]]
    lines.extend(f"stays    {entry['path']}  ({entry['reason']})" for entry in data["staying"])
    label = data["tag"] or data["commit"][:7]
    if data["mode"] == "plan":
        lines.append(f"migrate: plan only; {data['documents']} documents of {data['product']} {label}"
                     f" would move to {data['repository']}/{data['product']}/, with their history")
        lines.append("migrate: add --apply to write both sides, --push to send the two branches")
        return "\n".join(lines) + "\n"
    lines.append(f"readme   {data['readme']}")
    lines.append(f"migrate: {data['repository']} branch {data['documentsBranch']} ({data['documentsCommit'][:7]}),"
                 f" {data['product']} branch {data['productBranch']} ({data['productCommit'][:7]})")
    lines.append("migrate: pushed; open one pull request on each side"
                 if data["pushed"] else f"migrate: nothing pushed; both clones are in {data['kept']}")
    return "\n".join(lines) + "\n"


TEXT = {
    "migrate": text_migrate,
    "new": text_new,
    "adopt": text_adopt,
    "check": text_check,
    "declarations": text_declarations,
    "preflight": text_preflight,
    "rehearse": lambda data: (f"rehearse: {data['target']} built " + ", ".join(data["artifacts"]) + "\n"
                              if data["mode"] == "package" else f"rehearse: check passed on {data['target']}\n"),
    "render": lambda data: f"rendered {data['output']}\n",
    "tap": text_tap,
    "self-test": lambda data: "self-test: ok\n",
    "vendor": lambda data: (f"vendor: bin/maelys_cli.py is maelys-cli {data['tag']} ({data['commit'][:7]}),"
                            f" sha256 {data['sha256'][:12]}, " + ("updated" if data["changed"] else "unchanged") + "\n"),
}


# ---- the catalog --------------------------------------------------------------

